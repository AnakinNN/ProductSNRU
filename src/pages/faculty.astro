const staffMembers = [
	{
		name: "นางสาวมณฑาทิพย์ สะท้านไตรภพ (พี่จีน)",
		nameEn: "Ms. Monthathip Sathan-traiphop",
		title: "เจ้าหน้าที่บริหารงานทั่วไป",
		specialty: "งานบริหารงานทั่วไป, งานสารบัญ, ประสานงานทั่วไปประจำสาขาวิชา",
		// email: "monthathip.sa@snru.ac.th",
		office: "ห้องสำนักงานสาขาวิชาเครื่องกลและการผลิต อาคารเทคโนโลยีอุตสาหกรรม",
		avatar: "MS",
		image: "/images/faculty/monthathip_sa.jpg"
	}
