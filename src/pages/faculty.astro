---

<Layout title="คณาจารย์และบุคลากร - สาขาวิชาวิศวกรรมเครื่องกลและการผลิต">
	<Header />
	<main class="page-container">
		<!-- Hero Section -->
		<section class="faculty-hero">
			<div class="hero-overlay"></div>
			<div class="container hero-content">
				<h1>คณาจารย์และบุคลากร / Faculty & Staff</h1>
				<p>คณาจารย์ผู้มีความเชี่ยวชาญพร้อมถ่ายทอดองค์ความรู้ ประสบการณ์ และร่วมวิจัยเพื่อขับเคลื่อนนวัตกรรมสู่ท้องถิ่น</p>
			</div>
		</section>

		<!-- Head of Department Highlight -->
		{headOfDept && (
			<section class="head-highlight-section">
				<div class="container">
					<h2 class="section-title">หัวหน้าสาขาวิชา / Department Head</h2>
					
					<div class="head-card fade-in">
						<div class="head-avatar-wrapper">
							{headOfDept.image ? (
								<img src={`${base}${headOfDept.image}`} alt={headOfDept.name} class="head-avatar-img" />
							) : (
								<div class="avatar-circle">{headOfDept.avatar}</div>
							)}
						</div>
						<div class="head-info">
							<span class="title-badge">{headOfDept.title}</span>
							<h3>{headOfDept.name}</h3>
							<span class="en-name">{headOfDept.nameEn}</span>
							<hr class="divider" />
							<p class="credential">🎓 <strong>วุฒิการศึกษา:</strong> {headOfDept.degree}</p>
							<p class="specialty">⚙️ <strong>ความเชี่ยวชาญ:</strong> {headOfDept.specialty}</p>
							<p class="office">📍 <strong>ห้องพัก/สำนักงาน:</strong> {headOfDept.office}</p>
							{headOfDept.email && <p class="email">✉️ <strong>อีเมลติดต่อ:</strong> <a href={`mailto:${headOfDept.email}`}>{headOfDept.email}</a></p>}
						</div>
					</div>
				</div>
			</section>
		)}

		<!-- Faculty Grid -->
		<section class="faculty-grid-section">
			<div class="container">
				<h2 class="section-title">อาจารย์ประจำสาขาวิชา / Faculty Members</h2>
				
				<div class="faculty-grid">
					{lecturers.map(lect => (
						<div class="faculty-card">
							<div class="card-avatar-wrapper">
								{lect.image ? (
									<img src={`${base}${lect.image}`} alt={lect.name} class="avatar-image" />
								) : (
									<div class="avatar-circle">{lect.avatar}</div>
								)}
							</div>
							<div class="card-info">
								<span class="role-tag">{lect.title}</span>
								<h3>{lect.name}</h3>
								<span class="en-name">{lect.nameEn}</span>
								<hr class="divider-sm" />
								<p class="credential"><strong>การศึกษา:</strong> {lect.degree}</p>
								<p class="specialty"><strong>ความเชี่ยวชาญ:</strong> {lect.specialty}</p>
								<div class="contact-details">
									<span>📍 {lect.office}</span>
									{lect.email && <span>✉️ <a href={`mailto:${lect.email}`}>{lect.email}</a></span>}
								</div>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Staff Section -->
		{staffMembers.length > 0 && (
			<section class="staff-section">
				<div class="container">
					<h2 class="section-title">บุคลากรสายสนับสนุน / Support Staff</h2>
					
					<div class="faculty-grid">
						{staffMembers.map(staff => (
							<div class="faculty-card">
								<div class="card-avatar-wrapper">
									{staff.image ? (
										<img src={`${base}${staff.image}`} alt={staff.name} class="avatar-image" />
									) : (
										<div class="avatar-circle">{staff.avatar}</div>
									)}
								</div>
								<div class="card-info">
									<span class="role-tag">{staff.title}</span>
									<h3>{staff.name}</h3>
									<span class="en-name">{staff.nameEn}</span>
									<hr class="divider-sm" />
									<p class="specialty"><strong>ภาระหน้าที่:</strong> {staff.specialty}</p>
									<div class="contact-details">
										<span>📍 {staff.office}</span>
										{staff.email && <span>✉️ <a href={`mailto:${staff.email}`}>{staff.email}</a></span>}
									</div>
								</div>
							</div>
						))}
					</div>
				</div>
			</section>
		)}
	</main>
	<Footer />
</Layout>

<style>
	.page-container {
		min-height: 80vh;
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px;
	}

	/* Hero */
	.faculty-hero {
		position: relative;
		background: url('https://images.unsplash.com/photo-1523050335392-9bef867a0578?ixlib=rb-1.2.1&auto=format&fit=crop&w=1500&q=80') no-repeat center center;
		background-size: cover;
		padding: 100px 0;
		color: var(--white);
		text-align: center;
	}
	.hero-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, rgba(0, 107, 63, 0.8) 0%, rgba(26, 32, 44, 0.9) 100%);
	}
	.hero-content {
		position: relative;
		z-index: 2;
	}
	.hero-content h1 {
		font-size: 2.8rem;
		margin: 0 0 10px 0;
		font-weight: 700;
	}
	.hero-content p {
		font-size: 1.2rem;
		color: #E2E8F0;
		margin: 0;
		font-weight: 300;
	}

	/* Head Highlight */
	.head-highlight-section {
		padding: 80px 0 40px 0;
		background: var(--white);
	}
	.head-card {
		display: grid;
		grid-template-columns: 1fr 2fr;
		background: var(--background);
		border-radius: var(--border-radius);
		box-shadow: var(--shadow-md);
		border-left: 6px solid var(--accent);
		overflow: hidden;
		max-width: 900px;
		margin: 0 auto;
		align-items: center;
	}
	.head-card:hover {
		box-shadow: var(--shadow-lg);
	}
	.head-avatar-wrapper {
		display: flex;
		justify-content: center;
		padding: 40px;
	}
	.avatar-circle {
		width: 150px;
		height: 150px;
		background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
		color: var(--white);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 3rem;
		font-weight: 700;
		box-shadow: 0 4px 14px rgba(0, 107, 63, 0.3);
		border: 4px solid var(--white);
	}
	.head-info {
		padding: 40px 40px 40px 0;
	}
	.title-badge {
		background: var(--primary-light);
		color: var(--primary-dark);
		font-weight: 700;
		font-size: 0.8rem;
		padding: 6px 14px;
		border-radius: 20px;
		display: inline-block;
		margin-bottom: 12px;
	}
	.head-info h3 {
		font-size: 1.8rem;
		color: var(--text);
		margin: 0 0 4px 0;
		font-weight: 700;
	}
	.head-info .en-name {
		font-size: 1rem;
		color: var(--secondary);
		display: block;
		margin-bottom: 15px;
	}
	.divider {
		border: none;
		border-top: 1px solid #E2E8F0;
		margin-bottom: 20px;
	}
	.head-info p {
		margin: 10px 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--text);
	}
	.head-info a {
		color: var(--primary);
		font-weight: 700;
	}
	.head-info a:hover {
		color: var(--accent-pink);
		text-decoration: underline;
	}

	/* Faculty Grid Section */
	.faculty-grid-section {
		padding: 60px 0 40px 0;
		background: var(--background);
	}
	.faculty-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
		gap: 30px;
	}
	.faculty-card {
		background: var(--white);
		border-radius: var(--border-radius);
		box-shadow: var(--shadow-sm);
		border: 1px solid #E2E8F0;
		display: grid;
		grid-template-columns: 1fr 2.2fr;
		align-items: center;
		overflow: hidden;
		transition: var(--transition);
	}
	.faculty-card:hover {
		transform: translateY(-5px);
		box-shadow: var(--shadow-lg);
		border-color: var(--primary-light);
	}
	.faculty-card .card-avatar-wrapper {
		display: flex;
		justify-content: center;
		padding: 20px;
	}
	.faculty-card .avatar-circle {
		width: 100px;
		height: 100px;
		font-size: 2rem;
		box-shadow: 0 4px 10px rgba(0, 107, 63, 0.15);
	}
	.card-info {
		padding: 25px 25px 25px 0;
	}
	.role-tag {
		font-size: 0.75rem;
		font-weight: 700;
		color: var(--primary);
		display: block;
		margin-bottom: 6px;
	}
	.card-info h3 {
		font-size: 1.25rem;
		color: var(--text);
		margin: 0 0 2px 0;
		font-weight: 700;
	}
	.card-info .en-name {
		font-size: 0.85rem;
		color: var(--secondary);
		display: block;
		margin-bottom: 12px;
	}
	.divider-sm {
		border: none;
		border-top: 1px solid #EDF2F7;
		margin-bottom: 12px;
	}
	.card-info p {
		margin: 6px 0;
		font-size: 0.85rem;
		line-height: 1.5;
		color: var(--text);
	}
	.contact-details {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin-top: 12px;
		font-size: 0.8rem;
		color: var(--text-light);
	}
	.contact-details a {
		color: var(--primary);
	}
	.contact-details a:hover {
		text-decoration: underline;
	}

	.avatar-image {
		width: 100px;
		height: 100px;
		border-radius: 50%;
		object-fit: cover;
		box-shadow: 0 4px 10px rgba(0, 107, 63, 0.15);
		border: 3px solid var(--white);
	}
	.head-avatar-img {
		width: 150px;
		height: 150px;
		border-radius: 50%;
		object-fit: cover;
		box-shadow: 0 4px 14px rgba(0, 107, 63, 0.3);
		border: 4px solid var(--white);
	}
	.staff-section {
		padding: 40px 0 80px 0;
		background: var(--background);
	}

	@media (max-width: 992px) {
		.faculty-grid {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 768px) {
		.head-card {
			grid-template-columns: 1fr;
			text-align: center;
		}
		.head-info {
			padding: 0 30px 40px 30px;
		}
		.faculty-card {
			grid-template-columns: 1fr;
			text-align: center;
		}
		.card-info {
			padding: 0 25px 25px 25px;
		}
	}
</style>
