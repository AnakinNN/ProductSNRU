---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return [
    {
      params: { id: 'mechanical-production' },
      props: {
        name: 'วิศวกรรมเครื่องกลและการผลิต',
        nameEn: 'Mechanical and Production Engineering',
        faculty: 'คณะเทคโนโลยีอุตสาหกรรม',
        degree: 'วิศวกรรมศาสตรบัณฑิต (วศ.บ. วิศวกรรมเครื่องกลและการผลิต) • Bachelor of Engineering (Mechanical and Production Engineering)',
        credits: '133 หน่วยกิต',
        fee: '9,000 บาท/ภาคการศึกษา',
        overview: 'หลักสูตรวิศวกรรมเครื่องกลและการผลิต มุ่งเน้นการผลิตวิศวกรวิชาชีพที่มีความเชี่ยวชาญทั้งทางทฤษฎีและปฏิบัติ ครอบคลุมวิชาการด้านความร้อนและกลศาสตร์ทางวิศวกรรม กระบวนการแปรรูปและวัสดุศาสตร์ ระบบควบคุมอัตโนมัติ เทคโนโลยีหุ่นยนต์ สมาร์ท CNC และคอมพิวเตอร์เขียนแบบ CAD/CAM/CAE เพื่อนำไปประยุกต์ใช้งานจริงในภาคอุตสาหกรรมในยุคดิจิทัล',
        curriculum: [
          { year: 'วิชาเฉพาะพื้นฐาน (Basic Engineering)', desc: 'ฟิสิกส์วิศวกรรม + ปฏิบัติการ, เคมีวิศวกรรม + ปฏิบัติการ, แคลคูลัสวิศวกรรม, กลศาสตร์วิศวกรรม, เขียนแบบวิศวกรรม (Engineering Drawing), การฝึกปฏิบัติงานวิศวกรรมโยธา ไฟฟ้า เครื่องกล และการผลิต' },
          { year: 'วิชาบังคับสาขา - งานระบบทางกลและพลังงาน (Mechanical & Energy Science)', desc: 'กลศาสตร์ของแข็ง (Solid Mechanics), เทอร์โมไดนามิกส์, กลศาสตร์ของไหล, วัสดุวิศวกรรม, การวัดและเครื่องมือวัดอุตสาหกรรม, วิศวกรรมบำรุงรักษา, เทคโนโลยีพลังงานและการอนุรักษ์' },
          { year: 'วิชาบังคับสาขา - งานผลิตและระบบควบคุม (Manufacturing & Automation)', desc: 'กระบวนการผลิต (Manufacturing Processes), คอมพิวเตอร์เพื่อการออกแบบและช่วยในการผลิต (CAD/CAM), ไฮดรอลิกส์และนิวแมติกส์, การควบคุมอัตโนมัติและระบบหุ่นยนต์, โลหะวิทยาและการทดสอบวัสดุ, วิศวกรรมการเชื่อมและงานโลหะแผ่น, การวางแผนและควบคุมการผลิต, เศรษฐศาสตร์วิศวกรรม, การควบคุมคุณภาพ' },
          { year: 'วิชาโครงงานและประสบการณ์วิชาชีพ (Project & Internship)', desc: 'ปริญญานิพนธ์วิศวกรรมเครื่องกลและการผลิต 1 & 2 (Senior Capstone Projects), การเตรียมสหกิจศึกษาและการฝึกสหกิจศึกษา ณ สถานประกอบการอุตสาหกรรม (Co-operative Education) เป็นเวลา 1 ภาคการศึกษา' }
        ],
        requirements: 'สำเร็จการศึกษาระดับ ม.6 (แผนวิทย์-คณิต หรือศิลป์-คำนวณ) หรือระดับ ปวช./ปวส. สาขาช่างยนต์ ช่างกลโรงงาน ช่างเชื่อม ช่างไฟฟ้า หรือสาขาทางด้านเทคโนโลยีอุตสาหกรรมที่เกี่ยวข้อง'
      }
    },
    {
      params: { id: 'production-logistics' },
      props: {
        name: 'วิศวกรรมการผลิตและโลจิสติกส์',
        nameEn: 'Manufacturing and Logistics Engineering',
        faculty: 'คณะเทคโนโลยีอุตสาหกรรม',
        degree: 'วิศวกรรมศาสตรบัณฑิต (วศ.บ. วิศวกรรมการผลิตและโลจิสติกส์) • Bachelor of Engineering (Manufacturing and Logistics Engineering)',
        credits: '127 หน่วยกิต',
        fee: '9,000 บาท/ภาคการศึกษา',
        overview: 'หลักสูตรวิศวกรรมการผลิตและโลจิสติกส์ มุ่งเน้นการสร้างวิศวกรที่มีความสามารถแบบบูรณาการในการจัดการสายการผลิตและการบริหารระบบโลจิสติกส์เชิงวิศวกรรม ตั้งแต่การออกแบบผลิตภัณฑ์ กระบวนการผลิต การวางแผนผลิต การควบคุมคุณภาพ ความปลอดภัยและสิ่งแวดล้อม ตลอดจนการจัดการคลังสินค้า สินค้าคงคลัง บรรจุภัณฑ์ การขนถ่าย และการออกแบบโซ่อุปทาน',
        curriculum: [
          { year: 'วิชาแกนและวิชาพื้นฐานทางวิศวกรรม (Core Engineering Principles)', desc: 'ฟิสิกส์วิศวกรรม + ปฏิบัติการ, แคลคูลัสวิศวกรรม, เคมีวิศวกรรม + ปฏิบัติการ, กลศาสตร์วิศวกรรม, เขียนแบบวิศวกรรม, การฝึกปฏิบัติงานโยธา ไฟฟ้า เครื่องกล, วัสดุวิศวกรรม, การโปรแกรมคอมพิวเตอร์' },
          { year: 'วิชาบังคับสาขา - การจัดการการผลิต (Manufacturing Management)', desc: 'กระบวนการผลิต, การวางแผนและควบคุมการผลิต, คอมพิวเตอร์เพื่อการเขียนแบบออกแบบ (CAD), คอมพิวเตอร์ช่วยในการผลิต (CAM), การศึกษาการทำงาน (Work Study), สถิติวิศวกรรม, เศรษฐศาสตร์วิศวกรรม, การควบคุมคุณภาพ (QC/QA)' },
          { year: 'วิชาบังคับสาขา - ระบบโลจิสติกส์และโซ่อุปทาน (Logistics & Supply Chain)', desc: 'การจัดการคลังสินค้าและสินค้าคงคลัง, การขนส่งและการกระจายสินค้า, การออกแบบบรรจุภัณฑ์และการขนถ่ายสินค้า, การจัดการโซ่อุปทานและโลจิสติกส์เชิงวิศวกรรม, วิศวกรรมการบำรุงรักษา, ความปลอดภัยในการทำงานและสิ่งแวดล้อม' },
          { year: 'วิชาเลือกเสรี โครงงาน และสหกิจศึกษา (Electives & Project)', desc: 'ปริญญานิพนธ์วิศวกรรมการผลิตและโลจิสติกส์ 1 & 2, การเตรียมสหกิจศึกษาและการฝึกปฏิบัติงานสหกิจศึกษา ณ สถานประกอบการขนส่งและโรงงานอุตสาหกรรม หรือวิชาเลือกเฉพาะทางด้านการวางผังโรงงาน ระบบอัตโนมัติ ฯลฯ' }
        ],
        requirements: 'สำเร็จการศึกษาระดับ ม.6 (ทุกแผนการเรียน) หรือระดับ ปวช./ปวส. สาขาวิชาช่างกล ช่างยนต์ ช่างเชื่อม ช่างเทคนิคอุตสาหกรรม หรือสาขาวิชาบริหารธุรกิจ โลจิสติกส์ การจัดการทั่วไป หรือสาขาที่เกี่ยวข้อง'
      }
    }
  ];
}

const { id } = Astro.params;
const { name, nameEn, faculty, degree, credits, fee, overview, curriculum, requirements } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title={`${name} - หลักสูตรที่เปิดสอน`}>
	<Header />
	<main class="page-container">
		<div class="container">
			<a href={`${base}/programs`} class="back-link">&larr; กลับไปหน้ารวมหลักสูตร (Back to Programs)</a>
			
			<div class="program-header-card fade-in">
				<span class="faculty-tag">{faculty}</span>
				<h1>{name}</h1>
				<p class="name-en">{nameEn}</p>
				<p class="degree-desc"><strong>วุฒิการศึกษา:</strong> {degree}</p>
				<p class="credits-desc"><strong>จำนวนหน่วยกิตตลอดหลักสูตร:</strong> {credits}</p>
				<p class="credits-desc"><strong>อัตราค่าธรรมเนียมการศึกษา:</strong> {fee}</p>
			</div>
			
			<div class="content-grid">
				<div class="main-content">
					<section class="section">
						<h2>ภาพรวมหลักสูตร (Program Overview)</h2>
						<p class="overview-text">{overview}</p>
					</section>
					
					<section class="section">
						<h2>โครงสร้างแผนการศึกษา (Curriculum Plan)</h2>
						<div class="curriculum-timeline">
							{curriculum.map((item, index) => (
								<div class="timeline-item">
									<div class="timeline-badge">{index + 1}</div>
									<div class="timeline-content">
										<h3>{item.year}</h3>
										<p>{item.desc}</p>
									</div>
								</div>
							))}
						</div>
					</section>
				</div>
				
				<div class="side-content">
					<div class="side-card requirements-card">
						<h3>คุณสมบัติผู้สมัคร</h3>
						<p>{requirements}</p>
					</div>

					<div class="side-card contact-card">
						<h3>สอบถามข้อมูลหลักสูตร</h3>
						<p>สนใจเข้าศึกษาหรือขอรายละเอียดโครงสร้างการเรียนเพิ่มเติม ติดต่อเจ้าหน้าที่ประจำหลักสูตร</p>
						<a href={`${base}/contact`} class="btn-contact">ช่องทางการติดต่อ &rarr;</a>
					</div>
				</div>
			</div>
		</div>
	</main>
	<Footer />
</Layout>


<style>
	.page-container {
		padding: 60px 0;
		min-height: 80vh;
		background: var(--background);
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px;
	}
	.back-link {
		color: var(--primary);
		display: inline-block;
		margin-bottom: 30px;
		font-weight: 700;
	}
	.back-link:hover {
		color: var(--accent-pink);
		transform: translateX(-5px);
	}

	/* Header Card */
	.program-header-card {
		background: var(--white);
		border-left: 6px solid var(--primary);
		border-radius: var(--border-radius);
		padding: 40px;
		box-shadow: var(--shadow-sm);
		margin-bottom: 40px;
	}
	.program-header-card h1 {
		color: var(--primary-dark);
		font-size: 2.2rem;
		margin: 10px 0 5px 0;
		font-weight: 700;
	}
	.name-en {
		font-size: 1.2rem;
		color: var(--secondary);
		margin: 0 0 20px 0;
		font-style: italic;
	}
	.degree-desc, .credits-desc {
		margin: 5px 0;
		font-size: 0.95rem;
		color: var(--text);
	}

	/* Layout Grid */
	.content-grid {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 40px;
	}
	.section {
		background: var(--white);
		border-radius: var(--border-radius);
		padding: 35px;
		box-shadow: var(--shadow-sm);
		margin-bottom: 30px;
	}
	.section h2 {
		color: var(--primary);
		font-size: 1.4rem;
		font-weight: 700;
		margin-top: 0;
		margin-bottom: 20px;
		border-bottom: 2px solid var(--primary-light);
		padding-bottom: 10px;
	}
	.overview-text {
		line-height: 1.8;
		color: var(--text);
		margin: 0;
		font-size: 0.95rem;
	}

	/* Timeline */
	.curriculum-timeline {
		display: flex;
		flex-direction: column;
		gap: 25px;
		position: relative;
		padding-left: 20px;
	}
	.curriculum-timeline::before {
		content: '';
		position: absolute;
		left: 5px;
		top: 10px;
		width: 2px;
		height: calc(100% - 20px);
		background: var(--primary-light);
	}
	.timeline-item {
		display: flex;
		gap: 20px;
		position: relative;
	}
	.timeline-badge {
		position: absolute;
		left: -25px;
		top: 2px;
		width: 22px;
		height: 22px;
		background: var(--primary);
		color: var(--white);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.75rem;
		font-weight: bold;
		box-shadow: 0 0 0 4px var(--white);
	}
	.timeline-content h3 {
		margin: 0 0 5px 0;
		font-size: 1.05rem;
		color: var(--primary-dark);
		font-weight: 700;
	}
	.timeline-content p {
		margin: 0;
		color: var(--secondary);
		line-height: 1.5;
		font-size: 0.9rem;
	}

	/* Side Content */
	.side-card {
		background: var(--white);
		border-radius: var(--border-radius);
		padding: 30px;
		box-shadow: var(--shadow-sm);
		margin-bottom: 30px;
		border: 1px solid #E2E8F0;
	}
	.side-card h3 {
		color: var(--primary);
		font-size: 1.25rem;
		margin-top: 0;
		margin-bottom: 15px;
		font-weight: 700;
	}
	.requirements-card {
		border-top: 4px solid var(--accent);
	}
	.requirements-card p {
		line-height: 1.6;
		font-size: 0.9rem;
		color: var(--text);
		margin: 0;
	}
	.contact-card p {
		line-height: 1.6;
		font-size: 0.9rem;
		color: var(--secondary);
		margin-bottom: 20px;
	}
	.btn-contact {
		display: inline-block;
		background: var(--primary);
		color: var(--white);
		padding: 10px 20px;
		border-radius: 6px;
		font-weight: 700;
		font-size: 0.9rem;
		transition: var(--transition);
	}
	.btn-contact:hover {
		background: var(--primary-dark);
		transform: translateY(-2px);
	}

	@media (max-width: 992px) {
		.content-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
