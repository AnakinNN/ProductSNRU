---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const programs = [
	{ id: "bsc-tech", name: "Bachelor of Science", faculty: "Science & Technology", description: "Focus on innovation and research." },
	{ id: "bed-edu", name: "Bachelor of Education", faculty: "Education", description: "Preparing the next generation of teachers." },
	{ id: "ba-arts", name: "Bachelor of Arts", faculty: "Humanities", description: "Creative arts and language studies." },
	{ id: "bb-mgmt", name: "Bachelor of Business", faculty: "Management Science", description: "Business leadership and entrepreneurship." }
];
---

<Layout title="Programs - SNRU Clone">
	<Header />
	<main class="page-container">
		<div class="container">
			<h1>Academic Programs</h1>
			<p class="intro">Discover the diverse range of programs offered at SNRU.</p>
			
			<div class="program-grid">
				{programs.map(p => (
					<a href={`${base}/programs/${p.id}`} class="program-card">
						<h3>{p.name}</h3>
						<span class="faculty">{p.faculty}</span>
						<p>{p.description}</p>
						<span class="view-more">Learn More &rarr;</span>
					</a>
				))}
			</div>
		</div>
	</main>
	<footer class="footer">
		<div class="container">
			<p>&copy; 2026 Sakon Nakhon Rajabhat University Prototype.</p>
		</div>
	</footer>
</Layout>

<style>
	.page-container {
		padding: 60px 0;
		min-height: 70vh;
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px;
	}
	h1 {
		color: var(--primary);
		font-size: 2.5rem;
		margin-bottom: 10px;
	}
	.intro {
		color: var(--secondary);
		margin-bottom: 40px;
	}
	.program-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 20px;
	}
	.program-card {
		background: #fff;
		padding: 25px;
		border-radius: 8px;
		border-top: 5px solid var(--primary);
		box-shadow: 0 4px 10px rgba(0,0,0,0.05);
	}
	.program-card h3 {
		margin: 0 0 10px 0;
	}
	.faculty {
		display: block;
		font-size: 0.9rem;
		color: var(--primary);
		font-weight: bold;
		margin-bottom: 15px;
	}
	.footer {
		background: #333;
		color: #fff;
		padding: 40px 0;
		text-align: center;
	}
</style>
