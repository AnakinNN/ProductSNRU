---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const programs = [
	{
		id: "production-mechanical",
		name: "สาขาวิชาเทคโนโลยีเครื่องกลการผลิต",
		nameEn: "Production Mechanical Technology",
		degree: "ทล.บ. (เทคโนโลยีบัณฑิต) • Bachelor of Industrial Technology (B.Ind.Tech.)",
		description: "มุ่งเน้นการผลิตนักเทคโนโลยีที่มีทักษะขั้นสูงด้านการควบคุมเครื่องจักรกล CNC การออกแบบชิ้นส่วนด้วย CAD/CAM/CAE และการดูแลระบบกลศาสตร์อุตสาหกรรม",
		duration: "4 ปี (8 ภาคการศึกษา)",
		credits: "128 หน่วยกิต",
		careers: ["วิศวกรการผลิต / ผู้ช่วยวิศวกรเครื่องกล", "นักออกแบบชิ้นส่วนด้วย CAD/CAM", "ผู้ควบคุมเครื่องจักร CNC / ระบบอัตโนมัติ", "ผู้บริหารงานบำรุงรักษาในโรงงานอุตสาหกรรม"]
	},
	{
		id: "industrial-tech",
		name: "สาขาวิชาเทคโนโลยีอุตสาหการ",
		nameEn: "Industrial Technology",
		degree: "ทล.บ. (เทคโนโลยีบัณฑิต) • Bachelor of Industrial Technology (B.Ind.Tech.)",
		description: "มุ่งเน้นการวางแผนกระบวนการผลิต การควบคุมคุณภาพ ความปลอดภัยในการทำงาน การวิเคราะห์และปรับปรุงประสิทธิภาพการทำงาน และการบริหารจัดการโลจิสติกส์",
		duration: "4 ปี (8 ภาคการศึกษา)",
		credits: "125 หน่วยกิต",
		careers: ["ผู้ช่วยวิศวกรอุตสาหการ", "เจ้าหน้าที่ควบคุมและประกันคุณภาพ (QA/QC)", "เจ้าหน้าที่ความปลอดภัยระดับวิชาชีพ (จป.วิชาชีพ)", "นักวิเคราะห์และควบคุมระบบสินค้าคงคลังและโลจิสติกส์"]
	}
];
---

<Layout title="หลักสูตรที่เปิดสอน - สาขาวิชาเครื่องกลการผลิตและอุตสาหการ">
	<Header />
	<main class="page-container">
		<!-- Hero Section -->
		<section class="programs-hero">
			<div class="hero-overlay"></div>
			<div class="container hero-content">
				<h1>หลักสูตรที่เปิดสอน / Academic Programs</h1>
				<p>ค้นหาอนาคตของคุณไปกับหลักสูตรวิชาชีพด้านการผลิตและอุตสาหกรรมที่ตอบโจทย์ตลาดแรงงานยุคปัจจุบัน</p>
			</div>
		</section>

		<!-- Programs Grid -->
		<section class="programs-section">
			<div class="container">
				<div class="program-grid">
					{programs.map(p => (
						<div class="program-card">
							<div class="card-header">
								<span class="degree-tag">{p.degree}</span>
								<h3>{p.name}</h3>
								<span class="en-name">{p.nameEn}</span>
							</div>
							<div class="card-body">
								<p class="desc">{p.description}</p>
								
								<div class="meta-info">
									<div class="meta-item">
										<span class="meta-label">🕒 ระยะเวลาเรียน:</span>
										<span class="meta-val">{p.duration}</span>
									</div>
									<div class="meta-item">
										<span class="meta-label">📚 จำนวนหน่วยกิต:</span>
										<span class="meta-val">{p.credits}</span>
									</div>
								</div>

								<div class="career-section">
									<h4>แนวทางการประกอบอาชีพ (Career Paths):</h4>
									<ul class="career-list">
										{p.careers.map(career => (
											<li>{career}</li>
										))}
									</ul>
								</div>
							</div>
							<div class="card-footer">
								<a href={`${base}/programs/${p.id}`} class="btn-learn">
									ดูรายละเอียดหลักสูตร / View Curriculum &rarr;
								</a>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.page-container {
		min-height: 80vh;
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px;
	}

	/* Hero */
	.programs-hero {
		position: relative;
		background: url('https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?ixlib=rb-1.2.1&auto=format&fit=crop&w=1500&q=80') no-repeat center center;
		background-size: cover;
		padding: 100px 0;
		color: var(--white);
		text-align: center;
	}
	.hero-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, rgba(0, 107, 63, 0.8) 0%, rgba(26, 32, 44, 0.9) 100%);
	}
	.hero-content {
		position: relative;
		z-index: 2;
	}
	.hero-content h1 {
		font-size: 2.8rem;
		margin: 0 0 10px 0;
		font-weight: 700;
	}
	.hero-content p {
		font-size: 1.2rem;
		color: #E2E8F0;
		margin: 0;
		font-weight: 300;
	}

	/* Grid */
	.programs-section {
		padding: 80px 0;
		background: var(--background);
	}
	.program-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(480px, 1fr));
		gap: 40px;
	}
	.program-card {
		background: var(--white);
		border-radius: var(--border-radius);
		border-top: 6px solid var(--primary);
		box-shadow: var(--shadow-sm);
		transition: var(--transition);
		display: flex;
		flex-direction: column;
		border-left: 1px solid #E2E8F0;
		border-right: 1px solid #E2E8F0;
		border-bottom: 1px solid #E2E8F0;
	}
	.program-card:hover {
		transform: translateY(-8px);
		box-shadow: var(--shadow-lg);
		border-top-color: var(--accent);
	}
	.card-header {
		padding: 30px;
		background: linear-gradient(180deg, var(--primary-light) 0%, rgba(255, 255, 255, 0) 100%);
		border-bottom: 1px solid #EDF2F7;
	}
	.degree-tag {
		display: inline-block;
		background: var(--primary);
		color: var(--white);
		font-size: 0.75rem;
		font-weight: 700;
		padding: 4px 10px;
		border-radius: 4px;
		margin-bottom: 12px;
	}
	.program-card:hover .degree-tag {
		background: var(--accent);
		color: #1A202C;
	}
	.card-header h3 {
		margin: 0 0 5px 0;
		font-size: 1.5rem;
		color: var(--primary-dark);
		font-weight: 700;
	}
	.en-name {
		font-size: 0.95rem;
		color: var(--secondary);
		font-style: italic;
	}
	.card-body {
		padding: 30px;
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 25px;
	}
	.desc {
		line-height: 1.6;
		color: var(--text);
		margin: 0;
		font-size: 0.95rem;
	}
	.meta-info {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 15px;
		background: var(--background);
		padding: 15px;
		border-radius: 8px;
	}
	.meta-item {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.meta-label {
		font-size: 0.8rem;
		color: var(--text-light);
	}
	.meta-val {
		font-weight: 700;
		font-size: 0.9rem;
		color: var(--text);
	}
	.career-section h4 {
		margin: 0 0 10px 0;
		font-size: 0.95rem;
		color: var(--primary);
		font-weight: 700;
	}
	.career-list {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.career-list li {
		position: relative;
		padding-left: 20px;
		font-size: 0.9rem;
		color: var(--secondary);
	}
	.career-list li::before {
		content: '✓';
		position: absolute;
		left: 0;
		color: var(--accent);
		font-weight: bold;
	}
	.card-footer {
		padding: 20px 30px;
		background: #F8FAFC;
		border-top: 1px solid #EDF2F7;
		border-bottom-left-radius: var(--border-radius);
		border-bottom-right-radius: var(--border-radius);
	}
	.btn-learn {
		display: block;
		text-align: center;
		color: var(--primary);
		font-weight: 700;
		transition: var(--transition);
		font-size: 0.95rem;
	}
	.program-card:hover .btn-learn {
		color: var(--accent-pink);
		transform: translateX(5px);
	}

	@media (max-width: 992px) {
		.program-grid {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 768px) {
		.programs-hero {
			padding: 60px 0;
		}
		.hero-content h1 {
			font-size: 2rem;
		}
	}
</style>
