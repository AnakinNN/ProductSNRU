                  data-keywords={s.keywords.join(",")}
                  data-category={s.category}
                >
                  <div class="card-top">
                    <span class="company-badge"><i class="bi bi-building"></i> {s.company}</span>
                    <span class={`category-tag tag-${s.category.toLowerCase().replace('/', '-')}`}>
                      {s.category}
                    </span>
                  </div>
                  
                  <div class="student-info">
                    <div class="student-avatar">
                      {idx + 1}
                    </div>
                    <div>
                      <h4 class="student-name">{s.name}</h4>
                      <p class="student-label">รุ่นพี่ฝึกประสบการณ์วิชาชีพ (4 เดือน)</p>
                    </div>
                  </div>

                  <div class="card-details">
                    <div class="detail-row">
                      <span class="detail-label text-green"><i class="bi bi-plus-circle-fill"></i> จุดเด่น / ข้อดี:</span>
                      <p>{s.strength}</p>
                    </div>
                    
                    <div class="detail-row">
                      <span class="detail-label text-accent"><i class="bi bi-dash-circle-fill"></i> ข้อสังเกต / ข้อเสีย:</span>
                      <p>{s.weakness || "-"}</p>
                    </div>

                    <div class="detail-row border-top">
                      <span class="detail-label text-primary"><i class="bi bi-exclamation-triangle-fill"></i> ทักษะที่ขาด / พบความสำคัญ:</span>
                      <p class="highlight-text">{s.gap}</p>
                    </div>

                    <div class="detail-row bg-light">
                      <span class="detail-label"><i class="bi bi-chat-right-quote-fill"></i> คำแนะนำถึงรุ่นน้อง:</span>
                      <p class="italic-text">"{s.suggestion}"</p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            
            <div class="no-results" id="no-results-msg" style="display: none;">
              <i class="bi bi-inbox-fill"></i>
              <p>ไม่พบข้อมูลตามคำค้นหาที่ระบุ ลองพิมพ์คำอื่นๆ เช่น 'ภาษา' หรือ 'ขยัน'</p>
            </div>
          </div>
        </div>

        <!-- TAB CONTENT 4: Roadmap -->
        <div class="tab-pane" id="tab-roadmap">
          <div class="roadmap-wrapper">
            <h2 class="roadmap-title">เส้นทางเตรียมความพร้อม 4 ขั้นตอนสู่อุตสาหกรรมมืออาชีพ</h2>
            <p class="roadmap-subtitle">แผนการพัฒนาตนเองอย่างเป็นระบบเพื่อการฝึกประสบการณ์วิชาชีพที่ประสบความสำเร็จ</p>

            <div class="timeline">
              <!-- Step 1 -->
              <div class="timeline-item">
                <div class="timeline-badge">1</div>
                <div class="timeline-content">
                  <span class="step-label">ขั้นที่ 1: Mindset & Professionalism (ปรับทัศนคติก่อนลุยงาน)</span>
                  <h3>วินัย ความตรงต่อเวลา และหัวใจการเรียนรู้</h3>
                  <p>
                    ปรับพฤติกรรมให้ตรงต่อเวลาอย่างเคร่งครัดตามข้อเสนอแนะจากผู้ฝึกงานในกลุ่มอุตสาหกรรมชิ้นส่วนยานยนต์และงานฉีดพลาสติก ฝึกซ้อมการตื่นเช้าและการบริหารเวลา ตลอดจนเตรียมความพร้อมทางจิตวิทยาในการทำงานภายใต้สภาวะกดดัน และลดอัตราความประมาท (Safety First)
                  </p>
                  <ul class="step-list">
                    <li><i class="bi bi-check-circle"></i> ฝึกเข้าชั้นเรียนและกิจกรรมให้ตรงต่อเวลา 100%</li>
                    <li><i class="bi bi-check-circle"></i> ศึกษาและทบทวนกฎระเบียบวินัยโรงงานขั้นพื้นฐาน</li>
                    <li><i class="bi bi-check-circle"></i> ปรับทัศนคติแบบ "น้ำไม่เต็มแก้ว" พร้อมเรียนรู้จากวิศวกรพี่เลี้ยง</li>
                  </ul>
                </div>
              </div>

              <!-- Step 2 -->
              <div class="timeline-item">
                <div class="timeline-badge">2</div>
                <div class="timeline-content">
                  <span class="step-label">ขั้นที่ 2: Fundamental Engineering Tools (เสริมแกร่งวิชาชีพพื้นฐาน)</span>
                  <h3>การอ่านแบบเขียนแบบ และซอฟต์แวร์สนับสนุน</h3>
                  <p>
                    ฝึกฝนการอ่านแบบ Drawing วิศวกรรมซึ่งเป็นอุปสรรคสำคัญที่ผู้ฝึกงานมักทำงานเสีย (Scrap) หน้างาน รวมถึงการเสริมสร้างทักษะ Microsoft Excel และคอมพิวเตอร์พื้นฐานที่มักถูกมองข้ามแต่มีความสำคัญอย่างสูงในงานเอกสารวิศวกรรม
                  </p>
                  <ul class="step-list">
                    <li><i class="bi bi-check-circle"></i> ติวเข้มการอ่านแบบทางวิศวกรรมเครื่องกล (Orthographic / GD&T)</li>
                    <li><i class="bi bi-check-circle"></i> ฝึกการใช้งาน Excel (สูตรการเงิน, สถิติควบคุมคุณภาพ และกราฟสรุปผล)</li>
                    <li><i class="bi bi-check-circle"></i> ทดลองวิเคราะห์และเขียนแบบชิ้นงานง่ายๆ ผ่าน CAD</li>
                  </ul>
                </div>
              </div>

              <!-- Step 3 -->
              <div class="timeline-item">
                <div class="timeline-badge">3</div>
                <div class="timeline-content">
                  <span class="step-label">ขั้นที่ 3: Specialized Industrial Concepts (หลักการจัดการผลิตระดับสากล)</span>
                  <h3>หลักการลีน, Six Sigma และความรู้ระบบอัตโนมัติ</h3>
                  <p>
                    เรียนรู้แนวคิดลีนการผลิต (Lean Manufacturing) เพื่อลดความสูญเปล่าในนิคมอุตสาหกรรม (เช่น กลุ่มอุตสาหกรรมผลิตอุปกรณ์ส่องสว่างยานยนต์) รวมถึงการทบทวนพื้นฐานระบบเครื่องจักรและเครื่องมือช่างเฉพาะทาง
                  </p>
                  <ul class="step-list">
                    <li><i class="bi bi-check-circle"></i> ศึกษาแนวคิด 7 Wastes, 5S (5ส) และระบบควบคุมคุณภาพขั้นต้น</li>
                    <li><i class="bi bi-check-circle"></i> ศึกษาเทคโนโลยีพื้นฐานด้านพลังงาน เช่น แบตเตอรี่และยานยนต์ไฟฟ้า (EV)</li>
                    <li><i class="bi bi-check-circle"></i> เรียนรู้วิธีการใช้และดูแลรักษาเครื่องมือวัดอุตสาหกรรม (เช่น Vernier, Micrometer)</li>
                  </ul>
                </div>
              </div>

              <!-- Step 4 -->
              <div class="timeline-item">
                <div class="timeline-badge">4</div>
                <div class="timeline-content">
                  <span class="step-label">ขั้นที่ 4: Global Communication (ก้าวสู่มาตรฐานการประสานงานระดับสากล)</span>
                  <h3>ภาษาอังกฤษ จีน ญี่ปุ่น และการกล้าซักถาม</h3>
                  <p>
                    พัฒนาภาษาสำหรับการทำงานร่วมกับวิศวกรต่างชาติและบุคลากรในเครือข่ายอุตสาหกรรมข้ามชาติ และขยันสื่อสารประสานงานเพื่อลดความผิดพลาดในการแก้ไขปัญหาไม่ตรงจุด
                  </p>
                  <ul class="step-list">
                    <li><i class="bi bi-check-circle"></i> ท่องจำและทบทวนศัพท์เทคนิคภาษาอังกฤษ (Technical Vocabulary)</li>
                    <li><i class="bi bi-check-circle"></i> ศึกษาประโยคสนทนาและการรายงานผลพื้นฐาน (ภาษาอังกฤษ จีน หรือญี่ปุ่นตามเป้าหมายบริษัท)</li>
                    <li><i class="bi bi-check-circle"></i> ปรับทักษะความกล้าพูด กล้าถาม ขยันประสานงานกับพี่เลี้ยงอุตสาหกรรม</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</Layout>

<!-- Clientside Scripts for Tab Switching, Checklist Progress, and Explorer Search/Filter -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // 1. Tab Switch Logic
    const tabButtons = document.querySelectorAll(".tab-btn");
    const tabPanes = document.querySelectorAll(".tab-pane");

    tabButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        const targetTab = btn.getAttribute("data-tab");
        
        tabButtons.forEach(b => b.classList.remove("active"));
        tabPanes.forEach(p => p.classList.remove("active"));
        
        btn.classList.add("active");
        const activePane = document.getElementById(`tab-${targetTab}`);
        if (activePane) {
          activePane.classList.add("active");
        }
      });
    });

    // 2. Checklist Progress Logic
    const checkboxes = document.querySelectorAll(".prep-checkbox");
    const progressBar = document.getElementById("checklist-progress");
    const progressText = document.getElementById("checklist-progress-text");
    const resetBtn = document.getElementById("btn-reset-checklist");

    // Load initial checklist state from localStorage
    checkboxes.forEach(cb => {
      const saved = localStorage.getItem(`prep-chk-${cb.getAttribute("data-id")}`);
      if (saved === "true") {
        cb.checked = true;
      }
      
      cb.addEventListener("change", () => {
        localStorage.setItem(`prep-chk-${cb.getAttribute("data-id")}`, cb.checked);
        updateProgress();
      });
    });

    function updateProgress() {
      const total = checkboxes.length;
      const checked = Array.from(checkboxes).filter(c => c.checked).length;
      const pct = total > 0 ? Math.round((checked / total) * 100) : 0;
      
      if (progressBar) progressBar.style.width = `${pct}%`;
      if (progressText) {
        progressText.innerText = `ความพร้อมของคุณ: ${pct}% (${checked} จาก ${total} ข้อ)`;
      }
    }

    updateProgress();

    if (resetBtn) {
      resetBtn.addEventListener("click", () => {
        if (confirm("คุณต้องการล้างรายการเช็กความพร้อมทั้งหมดเพื่อเริ่มใหม่ใช่หรือไม่?")) {
          checkboxes.forEach(cb => {
            cb.checked = false;
            localStorage.removeItem(`prep-chk-${cb.getAttribute("data-id")}`);
          });
          updateProgress();
        }
      });
    }

    // 3. Explorer Search and Filter Logic
    const searchInput = document.getElementById("explorer-search");
    const filterButtons = document.querySelectorAll(".pill-btn");
    const feedbackCards = document.querySelectorAll(".feedback-card");
    const resultsCounter = document.getElementById("results-count");
    const noResultsMsg = document.getElementById("no-results-msg");

    let currentSearch = "";
    let currentFilter = "all";

    function filterData() {
      let count = 0;
      feedbackCards.forEach(card => {
        const name = card.getAttribute("data-name").toLowerCase();
        const company = card.getAttribute("data-company").toLowerCase();
        const strength = card.getAttribute("data-strength").toLowerCase();
        const weakness = card.getAttribute("data-weakness").toLowerCase();
        const gap = card.getAttribute("data-gap").toLowerCase();
        const suggestion = card.getAttribute("data-suggestion").toLowerCase();
        const keywords = card.getAttribute("data-keywords").toLowerCase();
        
        const textContent = `${name} ${company} ${strength} ${weakness} ${gap} ${suggestion} ${keywords}`;
        
        // Search condition
        const matchesSearch = textContent.includes(currentSearch);
        
        // Filter condition
        let matchesFilter = false;
        if (currentFilter === "all") {
          matchesFilter = true;
        } else if (currentFilter === "Lighting") {
          matchesFilter = company.includes("ส่องสว่าง");
        } else if (currentFilter === "Plastics") {
          matchesFilter = company.includes("พลาสติก");
        } else if (currentFilter === "Batteries") {
          matchesFilter = company.includes("แบตเตอรี่");
        } else if (currentFilter === "Machining") {
          matchesFilter = company.includes("ชิ้นส่วนกลไก") || company.includes("ประกอบ");
        } else if (currentFilter === "Other") {
          // Does not match Lighting, Plastics, Batteries, Machining
          matchesFilter = !company.includes("ส่องสว่าง") && 
                          !company.includes("พลาสติก") && 
                          !company.includes("แบตเตอรี่") && 
                          !company.includes("ชิ้นส่วนกลไก") && 
                          !company.includes("ประกอบ");
        }

        if (matchesSearch && matchesFilter) {
          card.style.display = "flex";
          count++;
        } else {
          card.style.display = "none";
        }
      });

      if (resultsCounter) {
        resultsCounter.innerText = `กำลังแสดงข้อมูลรุ่นพี่ ${count} รายการ`;
      }

      if (noResultsMsg) {
        noResultsMsg.style.display = count === 0 ? "block" : "none";
      }
    }

    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        currentSearch = e.target.value.toLowerCase().trim();
        filterData();
      });
    }

    filterButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        filterButtons.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        currentFilter = btn.getAttribute("data-filter");
        filterData();
      });
    });
  });
</script>

