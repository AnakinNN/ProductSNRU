---

<Layout title="เตรียมความพร้อมฝึกงานอุตสาหกรรม - ผลการประเมินจากรุ่นพี่">
  <Header />

  <main class="dashboard-page">
    <!-- Hero Banner -->
    <section class="hero-banner">
      <div class="banner-overlay"></div>
      <div class="container banner-content">
        <span class="banner-tag">Student Insights & Dashboard</span>
        <h1>เตรียมความพร้อมฝึกประสบการณ์วิชาชีพ</h1>
        <p class="banner-desc">
          วิเคราะห์ทักษะและสมรรถนะที่จำเป็นในภาคอุตสาหกรรม จากข้อมูลจริงของนักศึกษารุ่นพี่หลังฝึกงานครบ 4 เดือน
        </p>
      </div>
    </section>

    <!-- Stats Summary Section -->
    <section class="stats-overview">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-icon-wrapper lang">
              <i class="bi bi-people-fill"></i>
            </div>
            <div class="stat-number">{totalStudents}</div>
            <div class="stat-label">แบบประเมินจากรุ่นพี่</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon-wrapper company">
              <i class="bi bi-building"></i>
            </div>
            <div class="stat-number">{uniqueCompaniesCount}</div>
            <div class="stat-label">บริษัทชั้นนำในภาคอุตสาหกรรม</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon-wrapper skill">
              <i class="bi bi-patch-check"></i>
            </div>
            <div class="stat-number">60%</div>
            <div class="stat-label">เน้นทักษะภาษา (En/Jp/Cn)</div>
          </div>
          <div class="stat-card">
            <div class="stat-icon-wrapper caution">
              <i class="bi bi-lightning-charge"></i>
            </div>
            <div class="stat-number">80%</div>
            <div class="stat-label">ชี้จุดสำคัญเรื่อง Soft Skills</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Navigation Tabs -->
    <section class="dashboard-tabs-section">
      <div class="container">
        <div class="tabs-container">
          <button class="tab-btn active" data-tab="analysis">
            <i class="bi bi-bar-chart-steps"></i> 1. วิเคราะห์สมรรถนะ (Skills Gap)
          </button>
          <button class="tab-btn" data-tab="checklist">
            <i class="bi bi-check2-square"></i> 2. รายการเตรียมตัว (Interactive Checklist)
          </button>
          <button class="tab-btn" data-tab="explorer">
            <i class="bi bi-database-fill-gear"></i> 3. ค้นหาข้อมูลรุ่นพี่ (Feedback Explorer)
          </button>
          <button class="tab-btn" data-tab="roadmap">
            <i class="bi bi-signpost-split-fill"></i> 4. แผนเส้นทางเตรียมพร้อม (Roadmap)
          </button>
        </div>

        <hr class="tab-divider" />

        <!-- TAB CONTENT 1: Analysis -->
        <div class="tab-pane active" id="tab-analysis">
          <div class="analysis-grid">
            <!-- Left Card: Hard Skills -->
            <div class="analysis-card border-green">
              <div class="card-header">
                <h3><i class="bi bi-tools text-green"></i> Hard Skills (ทักษะเฉพาะทางวิชาชีพ)</h3>
                <p>สิ่งที่หน้างานในนิคมอุตสาหกรรมคาดหวังให้พร้อมใช้งาน</p>
              </div>
              <div class="card-body">
                <div class="skill-meter-group">
                  <div class="meter-header">
                    <span><strong>1. ทักษะภาษาและการสื่อสาร (Languages)</strong></span>
                    <span class="percentage">60% (9 คนระบุ)</span>
                  </div>
                  <div class="meter-bar"><div class="fill" style="width: 60%"></div></div>
                  <p class="skill-detail">
                    ต้องการ<strong>ภาษาอังกฤษ</strong>สำหรับศัพท์เทคนิคหน้างาน, <strong>ภาษาจีน</strong> (เพื่อสื่อสารกับพนักงานชาวจีน) และ <strong>ภาษาญี่ปุ่น</strong> (สำหรับบริษัทข้ามชาติเครือญี่ปุ่น)
                  </p>
                </div>

                <div class="skill-meter-group">
                  <div class="meter-header">
                    <span><strong>2. การอ่านแบบเขียนแบบ (Drawing & GD&T)</strong></span>
                    <span class="percentage">20% (3 คนระบุ)</span>
                  </div>
                  <div class="meter-bar"><div class="fill" style="width: 20%"></div></div>
                  <p class="skill-detail">
                    การอ่าน Drawing วิศวกรรมเป็นหัวใจสำคัญ (ระบุโดยรุ่นพี่ที่ฝึกงานในกลุ่มอุตสาหกรรมชิ้นส่วนพลาสติก) เพื่อลดอัตราการเกิดชิ้นงานเสีย (Scrap)
                  </p>
                </div>

                <div class="skill-meter-group">
                  <div class="meter-header">
                    <span><strong>3. ระบบลีนและการผลิตแบบ Lean Manufacturing</strong></span>
                    <span class="percentage">20% (3 คนระบุ)</span>
                  </div>
                  <div class="meter-bar"><div class="fill" style="width: 20%"></div></div>
                  <p class="skill-detail">
                    ความรู้พื้นฐานเรื่อง <strong>Lean</strong> และ <strong>Six Sigma</strong> ถูกเรียกร้องโดยตรงจากผู้ฝึกงานในกลุ่มผลิตอุปกรณ์อิเล็กทรอนิกส์ยานยนต์
                  </p>
                </div>

                <div class="skill-meter-group">
                  <div class="meter-header">
                    <span><strong>4. การใช้โปรแกรมคอมพิวเตอร์ (Excel & Tooling)</strong></span>
                    <span class="percentage">13.3% (2 คนระบุ)</span>
                  </div>
                  <div class="meter-bar"><div class="fill" style="width: 13.3%"></div></div>
                  <p class="skill-detail">
                    ทักษะการใช้ <strong>Microsoft Excel</strong> ในงานคำนวณและวิเคราะห์ข้อมูล รวมทั้งการเข้าใจเครื่องมือวัดช่างและซ่อมบำรุง
                  </p>
                </div>
              </div>
            </div>

            <!-- Right Card: Soft Skills -->
            <div class="analysis-card border-accent">
              <div class="card-header">
                <h3><i class="bi bi-shield-check text-accent"></i> Soft Skills (ทักษะทางสังคมและการใช้ชีวิต)</h3>
                <p>ตัวกำหนดประสิทธิภาพการปรับตัวและก้าวหน้าในการทำงานจริง</p>
              </div>
              <div class="card-body">
                <div class="soft-skill-badge-grid">
                  <div class="soft-badge-card">
                    <div class="icon-circle"><i class="bi bi-clock-history"></i></div>
                    <h4>ความตรงต่อเวลา (Punctuality)</h4>
                    <p>การเข้างานตรงเวลาตามระเบียบโรงงานอุตสาหกรรม มีผลต่อการประเมินมากที่สุด</p>
                  </div>
                  
                  <div class="soft-badge-card">
                    <div class="icon-circle"><i class="bi bi-heart-pulse"></i></div>
                    <h4>การรับแรงกดดัน (Stress Resilience)</h4>
                    <p>สภาพแวดล้อมการทำงานจริงมีเป้าหมาย (KPI) และความกดดันจากสายการผลิตที่ต้องแก้ไขปัญหาให้รวดเร็ว</p>
                  </div>

                  <div class="soft-badge-card">
                    <div class="icon-circle"><i class="bi bi-chat-dots"></i></div>
                    <h4>การกล้าถามและสื่อสาร (Active Voice)</h4>
                    <p>รุ่นพี่แนะนำ "ขยันถาม ขยันเรียนรู้ ขยันพูด" เพื่อแก้ปัญหาการทำงานไม่เรียบร้อยและการคุยงานที่คลาดเคลื่อน</p>
                  </div>

                  <div class="soft-badge-card">
                    <div class="icon-circle"><i class="bi bi-shield-exclamation"></i></div>
                    <h4>ความระมัดระวังและความปลอดภัย (Safety)</h4>
                    <p>การปฏิบัติตามมาตรฐานโรงงานอุตสาหกรรมอย่างเคร่งครัด "เตรียมตัวเตรียมใจ ระวังอย่าประมาท"</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- TAB CONTENT 2: Interactive Checklist -->
        <div class="tab-pane" id="tab-checklist">
          <div class="checklist-wrapper">
            <div class="checklist-header">
              <h2><i class="bi bi-check2-square text-green"></i> รายการเช็กความพร้อมส่วนบุคคล (My Prep Checklist)</h2>
              <p>ให้นักศึกษาคลิกเช็กความพร้อมแต่ละข้อ ข้อมูลจะถูกบันทึกไว้ในเครื่องอัตโนมัติเพื่อใช้วัดระดับตนเอง</p>
              
              <div class="progress-container">
                <div class="progress-bar-wrapper">
                  <div class="progress-bar-fill" id="checklist-progress" style="width: 0%"></div>
                </div>
                <div class="progress-text" id="checklist-progress-text">ความพร้อมของคุณ: 0% (0 จาก 10 ข้อ)</div>
              </div>
            </div>

            <div class="checklist-sections">
              <!-- Category 1: Languages -->
              <div class="check-section">
                <h3><i class="bi bi-translate text-green"></i> ทักษะภาษาและการทำงานร่วมกับต่างชาติ</h3>
                <label class="check-item">
                  <input type="checkbox" class="prep-checkbox" data-id="lang-en" />
                  <span class="custom-checkbox"></span>
                  <span class="item-text">
                    <strong>ทบทวนศัพท์เทคนิคภาษาอังกฤษ (Technical Terms)</strong> ที่ใช้ในโรงงานอุตสาหกรรม
                  </span>
                </label>
                <label class="check-item">
                  <input type="checkbox" class="prep-checkbox" data-id="lang-foreign" />
                  <span class="custom-checkbox"></span>
                  <span class="item-text">
                    <strong>เตรียมภาษาที่สามเบื้องต้น</strong> (เช่น ภาษาจีน หรือภาษาญี่ปุ่น ตามประเภทกลุ่มทุนของสถานประกอบการ)
                  </span>
                </label>
              </div>

              <!-- Category 2: Engineering Hard Skills -->
              <div class="check-section">
                <h3><i class="bi bi-gear-fill text-green"></i> ความรู้วิชาชีพด้านวิศวกรรมและการผลิต</h3>
                <label class="check-item">
                  <input type="checkbox" class="prep-checkbox" data-id="tech-drawing" />
                  <span class="custom-checkbox"></span>
                  <span class="item-text">
                    <strong>ฝึกฝนและทบทวนทักษะการอ่านแบบ Drawing</strong> รวมถึงความเข้าใจสัญลักษณ์และพิกัดความเผื่อ (GD&T)
                  </span>
                </label>
                <label class="check-item">
                  <input type="checkbox" class="prep-checkbox" data-id="tech-lean" />
                  <span class="custom-checkbox"></span>
                  <span class="item-text">
                    <strong>ศึกษาหลักการลีน (Lean Manufacturing)</strong> และแนวคิด Six Sigma เบื้องต้นก่อนเข้าฝึกงาน
                  </span>
                </label>
                <label class="check-item">
                  <input type="checkbox" class="prep-checkbox" data-id="tech-software" />
                  <span class="custom-checkbox"></span>
                  <span class="item-text">
                    <strong>ฝึกทักษะ Microsoft Excel ขั้นกลาง</strong> (สูตรคำนวณพื้นฐาน, VLOOKUP, Pivot Table) และเครื่องคอมพิวเตอร์
                  </span>
                </label>
                <label class="check-item">
                  <input type="checkbox" class="prep-checkbox" data-id="tech-ev" />
                  <span class="custom-checkbox"></span>
                  <span class="item-text">
                    <strong>ศึกษาทักษะเฉพาะโรงงาน</strong> เช่น ระบบรถยนต์ไฟฟ้า (EV) หรือการทำงานของแบตเตอรี่ หากเข้าทำงานบริษัทประกอบยานยนต์
                  </span>
                </label>
              </div>

              <!-- Category 3: Mindset & Professionalism -->
              <div class="check-section">
                <h3><i class="bi bi-briefcase-fill text-green"></i> วินัย จรรยาบรรณ และการปรับตัว (Soft Skills)</h3>
                <label class="check-item">
                  <input type="checkbox" class="prep-checkbox" data-id="soft-punctual" />
                  <span class="custom-checkbox"></span>
                  <span class="item-text">
                    <strong>ฝึกวินัยความตรงต่อเวลา</strong> ปรับตัวกับเวลาการเข้าทำงานและการรายงานตัวที่เคร่งครัด
                  </span>
                </label>
                <label class="check-item">
                  <input type="checkbox" class="prep-checkbox" data-id="soft-comm" />
                  <span class="custom-checkbox"></span>
                  <span class="item-text">
                    <strong>ปรับทักษะการคุยประสานงาน</strong> (ขยันถามเมื่อไม่เข้าใจ ไม่เดาสุ่มเพื่อลดความเสียหายของงาน)
                  </span>
                </label>
                <label class="check-item">
                  <input type="checkbox" class="prep-checkbox" data-id="soft-pressure" />
                  <span class="custom-checkbox"></span>
                  <span class="item-text">
                    <strong>ฝึกฝนและเตรียมใจรับแรงกดดัน</strong> จากสภาพแวดล้อมหน้างานและการสลับกะหรือเป้าผลิต
                  </span>
                </label>
                <label class="check-item">
                  <input type="checkbox" class="prep-checkbox" data-id="soft-safety" />
                  <span class="custom-checkbox"></span>
                  <span class="item-text">
                    <strong>สร้างความตระหนักเรื่องความปลอดภัย (Safety First)</strong> การปฏิบัติตามมาตรฐานโรงงานอุตสาหกรรม
                  </span>
                </label>
              </div>
            </div>
            
            <div class="checklist-actions">
              <button class="btn-clear" id="btn-reset-checklist">
                <i class="bi bi-arrow-counterclockwise"></i> รีเซ็ตรายการทั้งหมด
              </button>
            </div>
          </div>
        </div>

        <!-- TAB CONTENT 3: Explorer Database -->
        <div class="tab-pane" id="tab-explorer">
          <div class="explorer-wrapper">
            <!-- Search Control Bar -->
            <div class="search-bar-container">
              <div class="search-input-wrapper">
                <i class="bi bi-search search-icon"></i>
                <input 
                  type="text" 
                  id="explorer-search" 
                  placeholder="ค้นหาตามชื่อรุ่นพี่, ประเภทธุรกิจ, คำสำคัญ เช่น 'ภาษา', 'Drawing', 'Lean', 'ขยัน'..." 
                />
              </div>

              <!-- Filter Pills -->
              <div class="filter-pills">
                <span class="filter-label">หมวดหมู่สถานประกอบการ:</span>
                <button class="pill-btn active" data-filter="all">ทั้งหมด</button>
                <button class="pill-btn" data-filter="Lighting">อุตสาหกรรมอุปกรณ์ส่องสว่าง</button>
                <button class="pill-btn" data-filter="Plastics">อุตสาหกรรมชิ้นส่วนพลาสติก</button>
                <button class="pill-btn" data-filter="Batteries">อุตสาหกรรมแบตเตอรี่/พลังงาน</button>
                <button class="pill-btn" data-filter="Machining">อุตสาหกรรมชิ้นส่วนกลไกยานยนต์</button>
                <button class="pill-btn" data-filter="Other">กลุ่มงานบริการวิศวกรรมและอื่นๆ</button>
              </div>
            </div>

            <!-- Dynamic Feedback Counter -->
            <div class="explorer-meta">
              <span id="results-count">กำลังแสดงข้อมูลรุ่นพี่ 15 รายการ</span>
            </div>

            <!-- Feedback Card Grid -->
            <div class="feedback-grid" id="feedback-grid-container">
              {studentFeedbacks.map((s, idx) => (
                <div 
                  class="feedback-card" 
                  data-name={s.name}
                  data-company={s.company}
                  data-strength={s.strength}
                  data-weakness={s.weakness}
                  data-gap={s.gap}
