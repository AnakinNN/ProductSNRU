---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import NewsSection from "../components/NewsSection.astro";
import Events from "../components/Events.astro";
import Downloads from "../components/Downloads.astro";
---

<Layout title="สาขาวิชาเครื่องกลการผลิตและอุตสาหการ">
	<Header />
	<main>
		<Hero />
		<Stats />
		<NewsSection />
		<Events />
		<Downloads />
	</main>
	<footer class="footer">
		<div class="container">
			<p>
				&copy; 2026 สาขาวิชาเครื่องกลการผลิตและอุตสาหการ
				มหาวิทยาลัยราชภัฏสกลนคร
			</p>
		</div>
	</footer>
</Layout>

<style>
	.footer {
		background: #333;
		color: #fff;
		padding: 40px 0;
		text-align: center;
		margin-top: 60px;
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px;
	}
</style>
