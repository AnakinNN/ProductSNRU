---
const newsItems = [
	{
		title: "วิพากษ์หลักสูตรวิศวกรรมเครื่องกลและการผลิต ปีการศึกษา 2570",
		titleEn: "Mechanical and Production Engineering Program Review",
		date: "31 พฤษภาคม 2569",
		description: "รับฟังข้อเสนอแนะจากผู้ทรงคุณวุฒิ เพื่อพัฒนาหลักสูตรและยื่นขอรับรองจากสภาวิศวกร",
		image: "https://itech.snru.ac.th/wp-content/uploads/2026/05/708813776_27294066486890044_8835181024243514041_n-1024x768.jpg",
		category: "พัฒนาหลักสูตร",
		sourceUrl: "https://itech.snru.ac.th/topics/7869"
	},
	{
		title: "เตรียมความพร้อมฝึกงาน: จากชีวิตในห้องเรียนสู่วิศวกรตัวจริง",
		titleEn: "Preparing Fourth-Year Students for Industrial Internships",
		date: "18 กรกฎาคม 2568",
		description: "วิทยากรจากภาคอุตสาหกรรมแบ่งปันประสบการณ์ พร้อมแนะนำการทำ Resume และการเตรียมตัวฝึกงาน",
		image: "https://itech.snru.ac.th/wp-content/uploads/2025/07/519847806_1301743075289844_6195563562746409921_n-1024x577.jpg",
		category: "เตรียมฝึกประสบการณ์",
		sourceUrl: "https://itech.snru.ac.th/topics/7118"
	},
	{
		title: "ตรวจประเมินคุณภาพหลักสูตรวิศวกรรมเครื่องกลและการผลิต",
		titleEn: "Internal Quality Assessment for the B.Eng. Program",
		date: "20 มิถุนายน 2568",
		description: "การประเมินคุณภาพการศึกษาภายในระดับหลักสูตร วศ.บ. ประจำปีการศึกษา 2567 ณ อาคารปฏิบัติการวิศวกรรมและเทคโนโลยีอุตสาหกรรม",
		image: "",
		category: "ประกันคุณภาพ",
		sourceUrl: "https://itech.snru.ac.th/topics/6974"
	}
];
---
<section class="news-section">
	<div class="container">
		<h2 class="section-title">กิจกรรมและความเคลื่อนไหวของสาขา</h2>
		<p class="section-subtitle">ข่าวการพัฒนาหลักสูตร การเตรียมฝึกงาน และกิจกรรมจากเว็บไซต์คณะเทคโนโลยีอุตสาหกรรม</p>
		
		<div class="news-grid">
			{newsItems.map(item => (
				<article class="news-card">
					<div class="image-wrapper">
						{item.image ? (
							<img src={item.image} alt={item.title} loading="lazy" />
						) : (
							<div class="image-placeholder" aria-hidden="true"><span>⚙</span></div>
						)}
						<span class="category">{item.category}</span>
					</div>
					<div class="news-info">
						<span class="date">📅 {item.date}</span>
						<h3>{item.title}</h3>
						<p class="title-en">{item.titleEn}</p>
						<p class="description">{item.description}</p>
						<a class="source-link" href={item.sourceUrl} target="_blank" rel="noopener noreferrer">
							อ่านข่าวต้นฉบับ <span aria-hidden="true">↗</span>
						</a>
					</div>
				</article>
			))}
		</div>
		<div class="all-news-link">
			<a href="https://itech.snru.ac.th/topics/category/activities" target="_blank" rel="noopener noreferrer">
				ดูกิจกรรมเพิ่มเติมจากเว็บไซต์คณะ <span aria-hidden="true">↗</span>
			</a>
		</div>
	</div>
</section>

<style>
	.news-section {
		padding: 80px 0;
		background: var(--background);
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px;
	}
	.section-subtitle {
		text-align: center;
		color: var(--secondary);
		margin-top: -30px;
		margin-bottom: 50px;
		font-size: 1.1rem;
	}
	.news-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 30px;
	}
	.news-card {
		background: var(--white);
		border-radius: var(--border-radius);
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		transition: var(--transition);
		border: 1px solid #E2E8F0;
		display: flex;
		flex-direction: column;
	}
	.news-card:hover {
		transform: translateY(-8px);
		box-shadow: var(--shadow-lg);
		border-color: var(--primary-light);
	}
	.image-wrapper {
		position: relative;
		height: 220px;
		overflow: hidden;
	}
	.news-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: var(--transition);
	}
	.news-card:hover img {
		transform: scale(1.05);
	}
	.category {
		position: absolute;
		top: 15px;
		left: 15px;
		background: var(--primary);
		color: var(--white);
		font-weight: 700;
		font-size: 0.75rem;
		padding: 6px 14px;
		border-radius: 20px;
		box-shadow: var(--shadow-sm);
	}
	.news-info {
		padding: 24px;
		display: flex;
		flex-direction: column;
		flex: 1;
	}
	.date {
		color: var(--text-light);
		font-size: 0.85rem;
		margin-bottom: 10px;
	}
	h3 {
		margin: 0 0 10px 0;
		font-size: 1.15rem;
		color: var(--text);
		line-height: 1.5;
		font-weight: 700;
	}
	.title-en {
		color: var(--secondary);
		font-size: 0.85rem;
		line-height: 1.4;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.description {
		color: var(--text);
		font-size: 0.92rem;
		line-height: 1.6;
		margin: 14px 0 20px;
	}
	.image-placeholder {
		width: 100%;
		height: 100%;
		display: grid;
		place-items: center;
		background: linear-gradient(135deg, var(--primary-light), #d8e9df);
		color: var(--primary);
	}
	.image-placeholder span {
		font-size: 4rem;
		opacity: 0.75;
	}
	.source-link {
		margin-top: auto;
		color: var(--primary);
		font-size: 0.9rem;
		font-weight: 700;
	}
	.source-link:hover,
	.all-news-link a:hover {
		color: var(--primary-dark);
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.all-news-link {
		margin-top: 36px;
		text-align: center;
	}
	.all-news-link a {
		color: var(--primary);
		font-weight: 700;
	}
	
	@media (max-width: 768px) {
		.news-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
