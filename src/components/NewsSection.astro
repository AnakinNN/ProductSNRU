---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const newsItems = [
	{
		title: "นักศึกษาสาขาเครื่องกลการผลิตคว้ารางวัลชนะเลิศนวัตกรรมหุ่นยนต์ระดับประเทศ",
		titleEn: "Production Mechanical Students Win National Robot Innovation Award",
		date: "5 มิถุนายน 2569",
		image: "https://images.unsplash.com/photo-1485827404703-89b55fcc595e?ixlib=rb-1.2.1&auto=format&fit=crop&w=600&q=80",
		category: "รางวัล / Awards"
	},
	{
		title: "เปิดตัวห้องปฏิบัติการ CNC และระบบควบคุมอัตโนมัติอัจฉริยะเพื่อการเรียนรู้เชิงลึก",
		titleEn: "Launch of Smart CNC & Industrial Automation Laboratory for Deep Learning",
		date: "3 มิถุนายน 2569",
		image: "https://images.unsplash.com/photo-1581092160607-ee22621dd758?ixlib=rb-1.2.1&auto=format&fit=crop&w=600&q=80",
		category: "ห้องปฏิบัติการ / Labs"
	},
	{
		title: "ความร่วมมือทางวิชาการกับภาคอุตสาหกรรมหลักสูตรวิศวกรรมการผลิต",
		titleEn: "Academic Collaboration with Industrial Partners for Manufacturing Curriculum",
		date: "28 พฤษภาคม 2569",
		image: "https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?ixlib=rb-1.2.1&auto=format&fit=crop&w=600&q=80",
		category: "ความร่วมมือ / Collaboration"
	}
];
---
<section class="news-section">
	<div class="container">
		<h2 class="section-title">ข่าวประชาสัมพันธ์ & กิจกรรม</h2>
		<p class="section-subtitle">อัปเดตข้อมูลข่าวสารล่าสุด กิจกรรมเด่น และรางวัลความสำเร็จของสาขาวิชา</p>
		
		<div class="news-grid">
			{newsItems.map(item => (
				<article class="news-card">
					<div class="image-wrapper">
						<img 
							src={item.image} 
							alt={item.title} 
						/>
						<span class="category">{item.category}</span>
					</div>
					<div class="news-info">
						<span class="date">📅 {item.date}</span>
						<h3>{item.title}</h3>
						<p class="title-en">{item.titleEn}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.news-section {
		padding: 80px 0;
		background: var(--background);
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px;
	}
	.section-subtitle {
		text-align: center;
		color: var(--secondary);
		margin-top: -30px;
		margin-bottom: 50px;
		font-size: 1.1rem;
	}
	.news-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 30px;
	}
	.news-card {
		background: var(--white);
		border-radius: var(--border-radius);
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		transition: var(--transition);
		border: 1px solid #E2E8F0;
		display: flex;
		flex-direction: column;
	}
	.news-card:hover {
		transform: translateY(-8px);
		box-shadow: var(--shadow-lg);
		border-color: var(--primary-light);
	}
	.image-wrapper {
		position: relative;
		height: 220px;
		overflow: hidden;
	}
	.news-card img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: var(--transition);
	}
	.news-card:hover img {
		transform: scale(1.05);
	}
	.category {
		position: absolute;
		top: 15px;
		left: 15px;
		background: var(--primary);
		color: var(--white);
		font-weight: 700;
		font-size: 0.75rem;
		padding: 6px 14px;
		border-radius: 20px;
		box-shadow: var(--shadow-sm);
	}
	.news-info {
		padding: 24px;
		display: flex;
		flex-direction: column;
		flex: 1;
	}
	.date {
		color: var(--text-light);
		font-size: 0.85rem;
		margin-bottom: 10px;
	}
	h3 {
		margin: 0 0 10px 0;
		font-size: 1.15rem;
		color: var(--text);
		line-height: 1.5;
		font-weight: 700;
	}
	.title-en {
		color: var(--secondary);
		font-size: 0.85rem;
		line-height: 1.4;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	
	@media (max-width: 768px) {
		.news-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
