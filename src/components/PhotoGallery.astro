---
import fs from "fs";
import path from "path";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const galleryDir = path.resolve("public/images/gallery");

function formatCaption(fileName: string, index: number) {
  const stem = fileName.replace(/\.[^/.]+$/, "");
  if (/^IMG_\d+$/i.test(stem)) {
    return `ภาพกิจกรรมสาขาวิชา #${index + 1}`;
  }
  const activityMatch = stem.match(/^activity-(\d+)$/i);
  if (activityMatch) {
    return `กิจกรรมเด่นของสาขาวิชา #${parseInt(activityMatch[1], 10)}`;
  }
  return stem.replace(/[-_]+/g, " ");
}

let galleryItems: Array<{ file: string; src: string; caption: string }> = [];
if (fs.existsSync(galleryDir)) {
  const sortedFiles = fs
    .readdirSync(galleryDir)
    .filter((file) => /\.(png|jpg|jpeg|webp|gif)$/i.test(file))
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: "base" }));

  galleryItems = sortedFiles.map((file, index) => ({
    file,
    src: `${base}/images/gallery/${file}`,
    caption: formatCaption(file, index),
  }));
}
---

<div class="gallery-wrapper">
  <div class="gallery-header">
    <div class="header-text">
      <h2>📸 ภาพกิจกรรมล่าสุด / Recent Activities</h2>
      <p>ภาพบรรยากาศการเรียน การฝึกปฏิบัติงาน และกิจกรรมเด่นของสาขาวิชา (คลิกที่ภาพเพื่อขยายดูขนาดเต็ม)</p>
    </div>
  </div>

  {
    galleryItems.length === 0 ? (
      <div class="empty-gallery">
        <p>
          ยังไม่มีรูปภาพกิจกรรมในระบบ อัปโหลดไฟล์รูปภาพไปที่{" "}
          <code>public/images/gallery/</code> เพื่อเริ่มต้น
        </p>
      </div>
    ) : (
      <div class="gallery-grid" id="activity-gallery">
        {galleryItems.map((item, index) => (
          <button
            type="button"
            class="gallery-card"
            data-lightbox-index={index}
            data-src={item.src}
            data-caption={item.caption}
            aria-label={`เปิดดูภาพขนาดเต็ม: ${item.caption}`}
          >
            <div class="card-image-container">
              <img
                src={item.src}
                alt={item.caption}
                loading="lazy"
                decoding="async"
              />
              <div class="card-overlay">
                <span class="zoom-icon">🔎 ดูรูปขนาดเต็ม</span>
              </div>
            </div>
            <div class="card-info">
              <span class="file-tag">Activity Photo</span>
              <span class="file-name">{item.caption}</span>
            </div>
          </button>
        ))}
      </div>
    )
  }
</div>

<!-- Accessible Lightbox Modal -->
<div
  class="lightbox-backdrop"
  id="gallery-lightbox"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lightbox-caption"
  hidden
>
  <button type="button" class="lightbox-close" id="lightbox-close" aria-label="ปิดหน้าต่างดูภาพ">
    &times;
  </button>
  <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="ภาพก่อนหน้า">
    &#8249;
  </button>
  <figure class="lightbox-stage">
    <img id="lightbox-img" src="" alt="" />
    <figcaption class="lightbox-meta">
      <span id="lightbox-caption"></span>
      <span id="lightbox-counter"></span>
    </figcaption>
  </figure>
  <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="ภาพถัดไป">
    &#8250;
  </button>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const cards = Array.from(document.querySelectorAll<HTMLButtonElement>(".gallery-card[data-lightbox-index]"));
    const lightbox = document.getElementById("gallery-lightbox");
    const imgEl = document.getElementById("lightbox-img") as HTMLImageElement | null;
    const captionEl = document.getElementById("lightbox-caption");
    const counterEl = document.getElementById("lightbox-counter");
    const closeBtn = document.getElementById("lightbox-close");
    const prevBtn = document.getElementById("lightbox-prev");
    const nextBtn = document.getElementById("lightbox-next");

    if (!lightbox || !imgEl || cards.length === 0) return;

    let currentIndex = 0;
    let lastFocused: HTMLElement | null = null;

    const showImage = (index: number) => {
      currentIndex = (index + cards.length) % cards.length;
      const card = cards[currentIndex];
      const src = card.getAttribute("data-src") || "";
      const caption = card.getAttribute("data-caption") || "";

      imgEl.src = src;
      imgEl.alt = caption;
      if (captionEl) captionEl.textContent = caption;
      if (counterEl) counterEl.textContent = `${currentIndex + 1} / ${cards.length}`;
    };

    const openLightbox = (index: number) => {
      lastFocused = document.activeElement as HTMLElement | null;
      showImage(index);
      lightbox.hidden = false;
      document.body.style.overflow = "hidden";
      closeBtn?.focus();
    };

    const closeLightbox = () => {
      lightbox.hidden = true;
      document.body.style.overflow = "";
      lastFocused?.focus();
    };

    cards.forEach((card, index) => {
      card.addEventListener("click", () => openLightbox(index));
    });

    closeBtn?.addEventListener("click", closeLightbox);
    prevBtn?.addEventListener("click", () => showImage(currentIndex - 1));
    nextBtn?.addEventListener("click", () => showImage(currentIndex + 1));

    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener("keydown", (e) => {
      if (lightbox.hidden) return;
      if (e.key === "Escape") closeLightbox();
      else if (e.key === "ArrowLeft") showImage(currentIndex - 1);
      else if (e.key === "ArrowRight") showImage(currentIndex + 1);
    });
  });
</script>

<style>
  .gallery-wrapper {
    background: var(--white);
    border-radius: var(--border-radius);
    padding: 40px;
    box-shadow: var(--shadow-sm);
    border: 1px solid #e2e8f0;
  }

  .gallery-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 30px;
    gap: 20px;
    flex-wrap: wrap;
  }

  .header-text h2 {
    color: var(--primary);
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0 0 8px 0;
  }

  .header-text p {
    color: var(--secondary);
    font-size: 0.95rem;
    margin: 0;
  }

  .info-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--primary-light);
    color: var(--primary-dark);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .pulse-icon {
    width: 8px;
    height: 8px;
    background: var(--accent-pink);
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 0 rgba(231, 84, 128, 0.7);
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(231, 84, 128, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 6px rgba(231, 84, 128, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(231, 84, 128, 0);
    }
  }

  .empty-gallery {
    background: var(--background);
    padding: 40px;
    text-align: center;
    border-radius: 8px;
    border: 2px dashed #cbd5e0;
    color: var(--secondary);
  }

  /* Gallery Grid */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 25px;
    margin-bottom: 40px;
  }

  .gallery-card {
    background: var(--background);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid #e2e8f0;
    transition: var(--transition);
    cursor: pointer;
    padding: 0;
    text-align: left;
    font: inherit;
    color: inherit;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .gallery-card:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .gallery-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-color: var(--primary-light);
  }

  .card-image-container {
    height: 180px;
    position: relative;
    overflow: hidden;
    background: #edf2f7;
  }

  .card-image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition);
  }

  .gallery-card:hover .card-image-container img {
    transform: scale(1.08);
  }

  .card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 107, 63, 0.8);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: var(--transition);
  }

  .gallery-card:hover .card-overlay {
    opacity: 1;
  }

  .zoom-icon {
    color: var(--white);
    font-weight: 700;
    font-size: 0.85rem;
    border: 1px solid var(--white);
    padding: 6px 14px;
    border-radius: 20px;
  }

  .card-info {
    padding: 15px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .file-tag {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent-pink);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .file-name {
    font-size: 0.85rem;
    color: var(--text);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Instructions */
  .gallery-instructions {
    border-top: 1px solid #edf2f7;
    padding-top: 30px;
  }

  .instruction-card {
    background: var(--background);
    border-left: 4px solid var(--accent);
    padding: 20px;
    border-radius: 0 8px 8px 0;
  }

  .instruction-card h4 {
    margin: 0 0 10px 0;
    color: var(--primary-dark);
    font-weight: 700;
  }

  .instruction-card ol {
    margin: 0;
    padding-left: 20px;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--secondary);
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .instruction-card code {
    background: #e2e8f0;
    padding: 2px 6px;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.8rem;
    color: var(--text);
  }

  /* Lightbox Modal */
  .lightbox-backdrop[hidden] {
    display: none;
  }

  .lightbox-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 20, 29, 0.92);
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 64px;
    backdrop-filter: blur(4px);
  }

  .lightbox-stage {
    margin: 0;
    max-width: 1040px;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .lightbox-stage img {
    max-width: 100%;
    max-height: 78vh;
    object-fit: contain;
    border-radius: 10px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
    background: #111827;
  }

  .lightbox-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    width: 100%;
    color: #e2e8f0;
    font-size: 0.95rem;
  }

  .lightbox-close,
  .lightbox-nav {
    position: fixed;
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
  }

  .lightbox-close:hover,
  .lightbox-nav:hover {
    background: var(--primary);
    border-color: var(--accent);
  }

  .lightbox-close {
    top: 20px;
    right: 24px;
    width: 44px;
    height: 44px;
    font-size: 1.8rem;
    line-height: 1;
  }

  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    font-size: 2rem;
    line-height: 1;
  }

  .lightbox-prev {
    left: 16px;
  }

  .lightbox-next {
    right: 16px;
  }

  @media (max-width: 768px) {
    .gallery-wrapper {
      padding: 25px;
    }
    .gallery-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }
    .lightbox-backdrop {
      padding: 16px;
    }
    .lightbox-nav {
      width: 40px;
      height: 40px;
      font-size: 1.6rem;
    }
    .lightbox-prev {
      left: 8px;
    }
    .lightbox-next {
      right: 8px;
    }
  }
</style>
