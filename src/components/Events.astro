---
import { ADMISSIONS_INFO } from "../config.js";

const events = [
	{
		day: ADMISSIONS_INFO.deadlineDay,
		month: ADMISSIONS_INFO.deadlineMonth,
		monthEn: ADMISSIONS_INFO.deadlineMonthEn,
		yearLabel: `พ.ศ. ${ADMISSIONS_INFO.year}`,
		status: "upcoming",
		statusLabel: "กำลังเปิดรับสมัคร",
		title: `ปิดรับสมัครนักศึกษาใหม่ ปีการศึกษา ${ADMISSIONS_INFO.year} (${ADMISSIONS_INFO.round})`,
		titleEn: "2027 Admissions Application Deadline (Round 3)",
		time: "สมัครออนไลน์ตลอด 24 ชม.",
		location: "ระบบรับสมัครนักศึกษา มหาวิทยาลัยราชภัฏสกลนคร",
		link: ADMISSIONS_INFO.applicationUrl,
		linkText: "สมัครเรียนออนไลน์"
	},
	{
		day: "07",
		month: "ส.ค.",
		monthEn: "AUG",
		yearLabel: "พ.ศ. 2569",
		status: "past",
		statusLabel: "กิจกรรมประจำปี 2569",
		title: "การนำเสนอโครงงานนวัตกรรมและเทคโนโลยีเครื่องกลการผลิตประจำปี",
		titleEn: "Annual Mechanical & Industrial Innovation Project Showcase",
		time: "09:00 - 16:00 น.",
		location: "ห้องโถงนิทรรศการ อาคารปฏิบัติการเทคโนโลยีอุตสาหกรรม"
	},
	{
		day: "25",
		month: "ก.ค.",
		monthEn: "JUL",
		yearLabel: "พ.ศ. 2569",
		status: "past",
		statusLabel: "กิจกรรมประจำปี 2569",
		title: "ปฐมนิเทศนักศึกษาใหม่ ประจำปีการศึกษา 2569",
		titleEn: "Department Freshmen Welcome & Orientation 2026",
		time: "08:30 - 12:00 น.",
		location: "ห้องสัมมนา อาคารปฏิบัติการเทคโนโลยีอุตสาหกรรม"
	},
	{
		day: "18",
		month: "ก.ค.",
		monthEn: "JUL",
		yearLabel: "พ.ศ. 2569",
		status: "past",
		statusLabel: "กิจกรรมประจำปี 2569",
		title: "การประชุมวิชาการเทคโนโลยีการผลิตและอุตสาหการระดับชาติ 2569",
		titleEn: "National Manufacturing Tech & Industrial Engineering Conference 2026",
		time: "09:00 - 16:30 น.",
		location: "หอประชุมใหญ่ มหาวิทยาลัยราชภัฏสกลนคร"
	}
];
---
<section class="events-section">
	<div class="container">
		<h2 class="section-title">ปฏิทินกิจกรรมและกำหนดการ / Events & Schedule</h2>
		<div class="events-list">
			{events.map(event => (
				<div class={`event-item ${event.status === "upcoming" ? "event-upcoming" : "event-past"}`}>
					<div class="date-box">
						<span class="day">{event.day}</span>
						<span class="month">{event.month}</span>
						<span class="month-en">{event.monthEn} · {event.yearLabel.replace("พ.ศ. ", "")}</span>
					</div>
					<div class="event-details">
						<span class={`event-status ${event.status}`}>{event.statusLabel}</span>
						<h3>{event.title}</h3>
						<p class="title-en">{event.titleEn}</p>
						<div class="meta">
							<span>🕒 {event.time}</span>
							<span>📍 {event.location}</span>
						</div>
						{event.link && (
							<a href={event.link} target="_blank" rel="noopener noreferrer" class="event-cta">
								{event.linkText} <span aria-hidden="true">↗</span>
							</a>
						)}
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.events-section {
		padding: 80px 0;
		background: var(--white);
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px;
	}
	.events-list {
		display: flex;
		flex-direction: column;
		gap: 20px;
		max-width: 900px;
		margin: 0 auto;
	}
	.event-item {
		display: flex;
		align-items: center;
		padding: 25px;
		background: var(--background);
		border-radius: var(--border-radius);
		transition: var(--transition);
		gap: 25px;
		border-left: 5px solid var(--primary);
		box-shadow: var(--shadow-sm);
	}
	.event-item.event-upcoming {
		border-left-color: var(--accent);
		background: linear-gradient(90deg, rgba(212, 175, 55, 0.1) 0%, var(--background) 35%);
	}
	.event-item.event-past {
		opacity: 0.9;
	}
	.event-status {
		display: inline-block;
		font-size: 0.72rem;
		font-weight: 700;
		padding: 3px 10px;
		border-radius: 20px;
		margin-bottom: 8px;
	}
	.event-status.upcoming {
		background: var(--accent);
		color: #1A202C;
	}
	.event-status.past {
		background: #E2E8F0;
		color: var(--secondary);
	}
	.event-cta {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 12px;
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--primary);
	}
	.event-cta:hover {
		color: var(--primary-dark);
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.event-item:hover {
		transform: translateX(10px);
		box-shadow: var(--shadow-md);
		border-left-color: var(--accent);
	}
	.date-box {
		background: var(--primary);
		color: var(--white);
		min-width: 90px;
		height: 90px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border-radius: 8px;
		box-shadow: 0 4px 10px rgba(0, 107, 63, 0.25);
		transition: var(--transition);
	}
	.event-item:hover .date-box {
		background: var(--accent);
		color: #1A202C;
		box-shadow: 0 4px 10px rgba(212, 175, 55, 0.25);
	}
	.day {
		font-size: 1.8rem;
		font-weight: 700;
		line-height: 1;
	}
	.month {
		font-size: 0.85rem;
		font-weight: 500;
		margin-top: 2px;
	}
	.month-en {
		font-size: 0.7rem;
		opacity: 0.8;
		font-weight: 700;
		text-transform: uppercase;
	}
	.event-details {
		flex: 1;
	}
	.event-details h3 {
		margin: 0 0 6px 0;
		font-size: 1.15rem;
		color: var(--text);
		font-weight: 700;
		line-height: 1.4;
	}
	.title-en {
		margin: 0 0 10px 0;
		font-size: 0.85rem;
		color: var(--secondary);
	}
	.meta {
		display: flex;
		gap: 20px;
		color: var(--text-light);
		font-size: 0.85rem;
		flex-wrap: wrap;
	}
	@media (max-width: 600px) {
		.event-item {
			flex-direction: column;
			align-items: flex-start;
			gap: 15px;
		}
		.date-box {
			width: 100%;
			flex-direction: row;
			gap: 10px;
			height: 50px;
			min-width: auto;
		}
		.month-en {
			display: none;
		}
		.meta {
			flex-direction: column;
			gap: 5px;
		}
	}
</style>
