---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const applicationUrl = "https://regis.snru.ac.th/65_r3_sigup";
const applicationGuideUrl = "https://regis.snru.ac.th/step_regis.php";
---
<section class="hero">
	<div class="hero-overlay"></div>
	<div class="hero-content fade-in">
		<span class="hero-badge">รับสมัครนักศึกษาใหม่ ปีการศึกษา 2570 · รอบที่ 3</span>
		<h1>
			<span class="highlight">เรียนวิศวกรรมจากการลงมือทำจริง</span>
			<span class="highlight-alt">ต่อยอดสู่อุตสาหกรรม</span>
		</h1>
		<p class="hero-subtitle">
			เรียนรู้ตั้งแต่เครื่องจักรและกระบวนการผลิต ไปจนถึงระบบโลจิสติกส์
			เลือกเส้นทางที่ใช่จาก 2 หลักสูตร: วิศวกรรมเครื่องกลและการผลิต หรือวิศวกรรมการผลิตและโลจิสติกส์
		</p>
		<div class="admission-info" aria-label="ข้อมูลรับสมัคร">
			<strong>สมัครได้ถึง 7 พฤษภาคม 2570</strong>
			<span>รอบรับตรงทั่วไป · สมัครออนไลน์ · ไม่ต้องสอบข้อเขียน</span>
		</div>
		<div class="hero-ctas">
			<a href={applicationUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">สมัครเรียน ปี 2570</a>
			<a href={`${base}/programs`} class="btn btn-outline">ดูหลักสูตร</a>
		</div>
		<a href={applicationGuideUrl} target="_blank" rel="noopener noreferrer" class="hero-guide">
			ดูขั้นตอนสมัครและคุณสมบัติผู้สมัคร <span aria-hidden="true">↗</span>
		</a>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 550px;
		height: 70vh;
		background: url('https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?ixlib=rb-1.2.1&auto=format&fit=crop&w=1500&q=80') no-repeat center center;
		background-size: cover;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--white);
		text-align: center;
		padding: 40px 20px;
		overflow: hidden;
	}
	.hero-overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, rgba(0, 77, 46, 0.85) 0%, rgba(26, 32, 44, 0.9) 100%);
		z-index: 1;
	}
	.hero-content {
		position: relative;
		z-index: 2;
		max-width: 900px;
		margin: 0 auto;
	}
	.hero-badge {
		display: inline-flex;
		align-items: center;
		background: rgba(212, 175, 55, 0.15);
		border: 1px solid var(--accent);
		color: var(--accent);
		padding: 6px 16px;
		border-radius: 30px;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		margin-bottom: 20px;
		font-weight: 700;
	}
	.hero-content h1 {
		font-size: 3.5rem;
		line-height: 1.2;
		margin: 0 0 20px 0;
		font-weight: 700;
	}
	.hero-content h1 span {
		display: block;
	}
	.highlight {
		color: var(--white);
	}
	.highlight-alt {
		color: var(--accent);
		text-shadow: 0 2px 10px rgba(212, 175, 55, 0.3);
	}
	.hero-subtitle {
		font-size: 1.25rem;
		line-height: 1.6;
		margin-bottom: 35px;
		color: #E2E8F0;
		font-weight: 300;
		max-width: 750px;
		margin-left: auto;
		margin-right: auto;
	}
	.admission-info {
		display: flex;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
		gap: 6px 18px;
		margin: 0 auto 28px;
		color: #f7fafc;
		font-size: 0.95rem;
	}
	.admission-info strong {
		color: var(--accent);
	}
	.hero-ctas {
		display: flex;
		gap: 20px;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
	}
	.hero-guide {
		display: inline-block;
		margin-top: 18px;
		color: var(--white);
		font-size: 0.95rem;
		text-decoration: underline;
		text-decoration-color: rgba(255, 255, 255, 0.65);
		text-underline-offset: 4px;
	}
	.hero-guide:hover {
		color: var(--accent);
	}
	.btn {
		padding: 14px 28px;
		border-radius: 8px;
		font-weight: 700;
		font-size: 0.95rem;
		transition: var(--transition);
		cursor: pointer;
		display: inline-block;
	}
	.btn-primary {
		background: var(--accent);
		color: var(--primary-dark);
		border: 2px solid var(--accent);
		box-shadow: 0 4px 14px rgba(212, 175, 55, 0.35);
	}
	.btn-primary:hover {
		background: #e6c54d;
		border-color: #e6c54d;
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(212, 175, 55, 0.45);
	}
	.btn-outline {
		background: transparent;
		color: var(--white);
		border: 2px solid var(--white);
	}
	.btn-outline:hover {
		background: var(--white);
		color: var(--primary-dark);
		transform: translateY(-2px);
	}

	@media (max-width: 768px) {
		.hero {
			min-height: 480px;
			height: auto;
			padding: 56px 20px;
		}
		.hero-content h1 {
			font-size: 2.2rem;
		}
		.hero-badge {
			font-size: 0.75rem;
			padding: 6px 12px;
		}
		.hero-subtitle {
			font-size: 1rem;
		}
		.admission-info {
			flex-direction: column;
			gap: 4px;
			font-size: 0.9rem;
		}
		.hero-ctas {
			flex-direction: column;
			gap: 12px;
		}
		.btn {
			width: 100%;
			text-align: center;
		}
	}
</style>
