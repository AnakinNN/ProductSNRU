---
const base = import.meta.env.BASE_URL;
---
<section class="hero">
	<div class="hero-content">
		<h1>Welcome to SNRU</h1>
		<p>Discover excellence in education and research in Northeast Thailand.</p>
		<a href={`${base.replace(/\/$/, '')}/programs`} class="cta-button">Explore Programs</a>
	</div>
</section>

<style>
	.hero {
		height: 400px;
		background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1541339907198-e08756ebafe3?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80');
		background-size: cover;
		background-position: center;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--white);
		text-align: center;
	}
	.hero-content h1 {
		font-size: 3rem;
		margin-bottom: 1rem;
	}
	.hero-content p {
		font-size: 1.2rem;
		margin-bottom: 2rem;
	}
	.cta-button {
		background: var(--primary);
		color: var(--white);
		padding: 12px 24px;
		border-radius: 4px;
		font-weight: bold;
		transition: background 0.3s;
	}
	.cta-button:hover {
		background: #004494;
	}
</style>
