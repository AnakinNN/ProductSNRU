---
import { CONTACT_INFO, KVDB_CONFIG } from '../config.js';
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<footer class="main-footer">
	<div class="container footer-grid">
		<!-- Column 1: Info -->
		<div class="footer-col brand-col">
			<div class="footer-logo">
				<span class="logo-sub">สาขาวิชาเครื่องกลการผลิตและอุตสาหการ</span>
				<span class="logo-main">Production Mechanical & Industrial Engineering</span>
			</div>
			<p class="brand-desc">
				คณะเทคโนโลยีอุตสาหกรรม มหาวิทยาลัยราชภัฏสกลนคร
				มุ่งเน้นการสร้างวิศวกรและนักเทคโนโลยีมืออาชีพที่พร้อมรับใช้สังคมและพัฒนาประเทศ
			</p>
			<div class="social-links">
				<a href={CONTACT_INFO.facebook} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Facebook">
					<i class="bi bi-facebook"></i>
				</a>
				<a href={CONTACT_INFO.line} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Line">
					<i class="bi bi-line"></i>
				</a>
				<a href={CONTACT_INFO.youtube} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="YouTube">
					<i class="bi bi-youtube"></i>
				</a>
			</div>
		</div>

		<!-- Column 2: Quick Links -->
		<div class="footer-col">
			<h3>ลิงก์ด่วน (Quick Links)</h3>
			<ul class="footer-links">
				<li><a href={`${base}/about`}>เกี่ยวกับเรา (About)</a></li>
				<li><a href={`${base}/programs`}>หลักสูตรที่เปิดสอน (Programs)</a></li>
				<li><a href={`${base}/faculty`}>คณาจารย์และบุคลากร (Faculty)</a></li>
				<li><a href={`${base}/contact`}>ติดต่อเรา (Contact)</a></li>
			</ul>
		</div>

		<!-- Column 3: Contact Info -->
		<div class="footer-col">
			<h3>ติดต่อเรา (Contact Us)</h3>
			<ul class="contact-info">
				<li>
					<span class="icon">📍</span>
					<span class="text">
						อาคารปฏิบัติการเทคโนโลยีอุตสาหกรรม มหาวิทยาลัยราชภัฏสกลนคร<br/>
						680 ถ.นิตโย ต.ธาตุเชิงชุม อ.เมือง จ.สกลนคร 47000
					</span>
				</li>
				<li>
					<span class="icon">📞</span>
					<span class="text">โทรศัพท์: {CONTACT_INFO.phone}</span>
				</li>
				<li>
					<span class="icon">✉️</span>
					<span class="text">อีเมล: {CONTACT_INFO.email}</span>
				</li>
			</ul>
		</div>
	</div>

	<div class="footer-bottom" id="footer-tracker" data-api={KVDB_CONFIG.apiUrl} data-bucket={KVDB_CONFIG.bucketId}>
		<div class="container bottom-content">
			<p>&copy; {new Date().getFullYear()} สาขาวิชาเครื่องกลการผลิตและอุตสาหการ มหาวิทยาลัยราชภัฏสกลนคร. All Rights Reserved.</p>
			<div class="visitor-counter">
				<span class="icon">📈</span>
				<span>ผู้เข้าชมเว็บ: </span>
				<strong id="visitor-count-val">--</strong>
				<span> ครั้ง</span>
			</div>
			<div class="bottom-links">
				<a href="https://snru.ac.th" target="_blank" rel="noopener noreferrer">เว็บไซต์มหาวิทยาลัย (SNRU)</a>
			</div>
		</div>
	</div>
</footer>

<script>
	document.addEventListener('DOMContentLoaded', async () => {
		const tracker = document.getElementById('footer-tracker');
		if (!tracker) return;
		const api = tracker.getAttribute('data-api');
		const bucket = tracker.getAttribute('data-bucket');
		const countElement = document.getElementById('visitor-count-val');
		
		if (api && bucket && countElement) {
			const storageKey = 'snru_visited';
			const hasVisitedThisSession = sessionStorage.getItem(storageKey);
			
			try {
				let url = `${api}/${bucket}/visitor_hits`;
				let method = 'GET';
				
				// Only increment if they haven't visited in this session to prevent spamming count on refresh
				if (!hasVisitedThisSession) {
					url += '?action=increment&by=1';
					method = 'POST';
					sessionStorage.setItem(storageKey, 'true');
				}
				
				const response = await fetch(url, { method });
				if (response.ok) {
					const count = await response.text();
					countElement.textContent = parseInt(count).toLocaleString();
				}
			} catch (e) {
				console.error('Error tracking visitor hits:', e);
				// Fallback to GET count if increment fails
				try {
					const response = await fetch(`${api}/${bucket}/visitor_hits`);
					if (response.ok) {
						const count = await response.text();
						countElement.textContent = parseInt(count).toLocaleString();
					}
				} catch (err) {}
			}
		}
	});
</script>

<style>
	.main-footer {
		background: #1A202C;
		color: #E2E8F0;
		padding: 60px 0 0 0;
		font-size: 0.9rem;
		border-top: 4px solid var(--accent);
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px;
	}
	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 40px;
		padding-bottom: 40px;
	}
	.footer-col h3 {
		color: var(--white);
		font-size: 1.1rem;
		margin-top: 0;
		margin-bottom: 20px;
		position: relative;
		padding-bottom: 8px;
		font-weight: 700;
	}
	.footer-col h3::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 30px;
		height: 2px;
		background: var(--accent);
	}
	.brand-col {
		display: flex;
		flex-direction: column;
		gap: 15px;
	}
	.footer-logo {
		display: flex;
		flex-direction: column;
	}
	.logo-sub {
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--white);
	}
	.logo-main {
		font-size: 0.8rem;
		color: var(--accent);
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}
	.brand-desc {
		color: #A0AEC0;
		line-height: 1.6;
		font-size: 0.85rem;
		margin: 0;
	}
	.social-links {
		display: flex;
		gap: 12px;
		margin-top: 10px;
	}
	.social-icon {
		background: #2D3748;
		width: 36px;
		height: 36px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		font-size: 1.1rem;
		transition: var(--transition);
	}
	.social-icon:hover {
		background: var(--primary);
		transform: translateY(-3px);
	}
	.footer-links {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.footer-links a {
		color: #A0AEC0;
		transition: var(--transition);
	}
	.footer-links a:hover {
		color: var(--accent);
		padding-left: 5px;
	}
	.contact-info {
		display: flex;
		flex-direction: column;
		gap: 15px;
	}
	.contact-info li {
		display: flex;
		gap: 12px;
		align-items: flex-start;
	}
	.contact-info .icon {
		font-size: 1.1rem;
		margin-top: 2px;
	}
	.contact-info .text {
		color: #A0AEC0;
		line-height: 1.5;
		font-size: 0.85rem;
	}
	.footer-bottom {
		background: #0F141D;
		padding: 20px 0;
		border-top: 1px solid #2D3748;
		color: #718096;
		font-size: 0.8rem;
	}
	.bottom-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 15px;
	}
	.bottom-content p {
		margin: 0;
	}
	.visitor-counter {
		display: flex;
		align-items: center;
		gap: 6px;
		color: #A0AEC0;
		font-size: 0.8rem;
		background: #1A202C;
		padding: 4px 12px;
		border-radius: 12px;
		border: 1px solid #2D3748;
	}
	.visitor-counter strong {
		color: var(--accent);
		font-weight: 700;
	}
	.bottom-links a {
		color: #718096;
	}
	.bottom-links a:hover {
		color: var(--white);
	}

	@media (max-width: 992px) {
		.footer-grid {
			grid-template-columns: 1fr;
			gap: 30px;
		}
	}

	@media (max-width: 768px) {
		.bottom-content {
			flex-direction: column;
			text-align: center;
		}
	}
</style>
