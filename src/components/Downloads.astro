---
const base = import.meta.env.BASE_URL;

const documents = [
	{
		name: "Admission Guidelines 2026",
		fileName: "sample-form.txt", // Change this to your actual filename later
		type: "PDF",
		size: "1.2 MB"
	},
	{
		name: "University Academic Calendar",
		fileName: "sample-form.txt",
		type: "DOCX",
		size: "850 KB"
	}
];
---
<section class="downloads-section">
	<div class="container">
		<h2>Download Documents</h2>
		<div class="download-grid">
			{documents.map(doc => (
				<div class="download-item">
					<div class="file-icon">
						{doc.type === 'PDF' ? '📕' : '📘'}
					</div>
					<div class="file-info">
						<span class="file-name">{doc.name}</span>
						<span class="file-meta">{doc.type} • {doc.size}</span>
					</div>
					<a href={`${base.replace(/\/$/, '')}/documents/${doc.fileName}`} download class="download-btn">
						Download
					</a>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.downloads-section {
		padding: 60px 0;
		background: var(--background);
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px;
	}
	h2 {
		color: var(--primary);
		margin-bottom: 30px;
	}
	.download-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 20px;
	}
	.download-item {
		display: flex;
		align-items: center;
		padding: 20px;
		background: var(--white);
		border-radius: 8px;
		box-shadow: 0 2px 5px rgba(0,0,0,0.05);
		gap: 15px;
		transition: transform 0.2s;
	}
	.download-item:hover {
		transform: translateY(-3px);
		box-shadow: 0 4px 10px rgba(0,0,0,0.1);
	}
	.file-icon {
		font-size: 2rem;
	}
	.file-info {
		flex: 1;
		display: flex;
		flex-direction: column;
	}
	.file-name {
		font-weight: bold;
		font-size: 1rem;
		color: var(--text);
	}
	.file-meta {
		font-size: 0.8rem;
		color: var(--secondary);
	}
	.download-btn {
		background: var(--primary);
		color: var(--white);
		padding: 8px 16px;
		border-radius: 4px;
		font-size: 0.9rem;
		font-weight: bold;
		transition: background 0.3s;
	}
	.download-btn:hover {
		background: #004494;
	}

	@media (max-width: 600px) {
		.download-item {
			flex-direction: column;
			text-align: center;
		}
		.download-btn {
			width: 100%;
		}
	}
</style>
