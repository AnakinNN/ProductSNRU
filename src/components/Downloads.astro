---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const documents = [
	{
		name: "แผนการศึกษา หลักสูตรวิศวกรรมเครื่องกลและการผลิต (วศ.บ.)",
		nameEn: "Curriculum Plan - Mechanical and Production Engineering (B.Eng.)",
		fileName: "หลักสูตรวิศวกรรมเครื่องกลและการผลิต วศ.บ.pdf",
		type: "PDF",
		size: "3.1 MB"
	},
	/*
	{
		name: "แผนการเรียน หลักสูตรเทคโนโลยีอุตสาหการ (ปรับปรุง 2568)",
		nameEn: "Curriculum Map - Industrial Technology (2025 Revised)",
		fileName: "sample-form.txt",
		type: "PDF",
		size: "2.1 MB"
	},
	{
		name: "คู่มือนักศึกษาใหม่ สาขาวิชาเครื่องกลการผลิตและอุตสาหการ 2569",
		nameEn: "Student Handbook 2026 - Mechanical & Industrial Dept.",
		fileName: "sample-form.txt",
		type: "PDF",
		size: "4.8 MB"
	},
	{
		name: "แบบฟอร์มเสนอหัวข้อโครงงานพิเศษ (พิเศษ/ปริญญานิพนธ์)",
		nameEn: "Capstone Project / Thesis Proposal Request Form",
		fileName: "sample-form.txt",
		type: "DOCX",
		size: "125 KB"
	}
	*/
];
---
<section class="downloads-section">
	<div class="container">
		<h2 class="section-title">เอกสารดาวน์โหลด / Downloads</h2>
		<div class="download-grid">
			{documents.map(doc => (
				<div class="download-item">
					<div class="file-icon-wrapper" data-type={doc.type}>
						<span class="file-icon">{doc.type === 'PDF' ? '📕' : '📘'}</span>
						<span class="type-badge">{doc.type}</span>
					</div>
					<div class="file-info">
						<span class="file-name">{doc.name}</span>
						<span class="file-name-en">{doc.nameEn}</span>
						<span class="file-meta">ขนาดไฟล์: {doc.size}</span>
					</div>
					<div class="action-buttons">
						{doc.type === 'PDF' && (
							<a href={`${base}/documents/${doc.fileName}`} target="_blank" rel="noopener noreferrer" class="view-btn" title="เปิดดูเอกสาร">
								<span class="btn-icon">👁️</span>
								<span class="btn-text">เปิดดู</span>
							</a>
						)}
						<a href={`${base}/documents/${doc.fileName}`} download class="download-btn" title="ดาวน์โหลดเอกสาร">
							<span class="btn-text">ดาวน์โหลด</span>
							<span class="btn-arrow">&darr;</span>
						</a>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.downloads-section {
		padding: 80px 0;
		background: var(--background);
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 20px;
	}
	.download-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(450px, 1fr));
		gap: 20px;
	}
	.download-item {
		display: flex;
		align-items: center;
		padding: 20px;
		background: var(--white);
		border-radius: var(--border-radius);
		box-shadow: var(--shadow-sm);
		gap: 20px;
		transition: var(--transition);
		border: 1px solid #E2E8F0;
	}
	.download-item:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-md);
		border-color: var(--primary-light);
	}
	.file-icon-wrapper {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 65px;
		height: 65px;
		background: var(--background);
		border-radius: 8px;
		position: relative;
	}
	.file-icon {
		font-size: 1.8rem;
	}
	.type-badge {
		position: absolute;
		bottom: -5px;
		font-size: 0.65rem;
		font-weight: 700;
		color: var(--white);
		background: var(--secondary);
		padding: 2px 6px;
		border-radius: 4px;
	}
	.file-icon-wrapper[data-type="PDF"] .type-badge {
		background: #E53E3E;
	}
	.file-icon-wrapper[data-type="DOCX"] .type-badge {
		background: #3182CE;
	}
	.file-info {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.file-name {
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--text);
		line-height: 1.4;
	}
	.file-name-en {
		font-size: 0.8rem;
		color: var(--secondary);
	}
	.file-meta {
		font-size: 0.75rem;
		color: var(--text-light);
	}
	.action-buttons {
		display: flex;
		gap: 8px;
		align-items: center;
	}
	.download-btn {
		background: var(--primary-light);
		color: var(--primary-dark);
		padding: 8px 14px;
		border-radius: 6px;
		font-size: 0.8rem;
		font-weight: 700;
		display: flex;
		align-items: center;
		gap: 6px;
		transition: var(--transition);
		border: 1px solid transparent;
	}
	.download-btn:hover {
		background: var(--primary);
		color: var(--white);
	}
	.view-btn {
		background: var(--background);
		color: var(--secondary);
		padding: 8px 14px;
		border-radius: 6px;
		font-size: 0.8rem;
		font-weight: 700;
		display: flex;
		align-items: center;
		gap: 6px;
		transition: var(--transition);
		border: 1px solid #CBD5E0;
	}
	.view-btn:hover {
		background: var(--secondary);
		color: var(--white);
		border-color: var(--secondary);
	}
	.btn-icon, .btn-arrow {
		font-size: 0.9rem;
		line-height: 1;
	}

	@media (max-width: 992px) {
		.download-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 600px) {
		.download-item {
			flex-direction: column;
			text-align: center;
			padding: 25px;
		}
		.file-info {
			align-items: center;
		}
		.download-btn {
			width: 100%;
			justify-content: center;
		}
	}
</style>
