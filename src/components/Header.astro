---
import { CONTACT_INFO } from "../config.js";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const rawPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const normalizedPath = base && rawPath.startsWith(base)
	? (rawPath.slice(base.length) || "/")
	: rawPath;

const navItems = [
	{ href: `${base}/`, path: "/", label: "หน้าแรก (Home)" },
	{ href: `${base}/about`, path: "/about", label: "เกี่ยวกับเรา (About)" },
	{ href: `${base}/programs`, path: "/programs", label: "หลักสูตร (Programs)" },
	{ href: `${base}/faculty`, path: "/faculty", label: "คณาจารย์ (Faculty)" },
	{ href: `${base}/internship-prep`, path: "/internship-prep", label: "เตรียมฝึกงาน (Internship Prep)" },
	{ href: `${base}/contact`, path: "/contact", label: "ติดต่อเรา (Contact)" },
];

const isActive = (itemPath: string) =>
	itemPath === "/"
		? normalizedPath === "/"
		: normalizedPath === itemPath || normalizedPath.startsWith(`${itemPath}/`);
---

<header>
	<div class="top-bar">
		<div class="container">
			<span class="university-name">มหาวิทยาลัยราชภัฏสกลนคร • Sakon Nakhon Rajabhat University</span>
			<div class="top-links">
				<a href={CONTACT_INFO.facultyUrl} target="_blank" rel="noopener noreferrer">คณะเทคโนโลยีอุตสาหกรรม (ITECH)</a>
				<span class="top-divider" aria-hidden="true">•</span>
				<a href={CONTACT_INFO.universityUrl} target="_blank" rel="noopener noreferrer">SNRU Main Site</a>
			</div>
		</div>
	</div>
	<nav class="main-nav" aria-label="เมนูหลัก">
		<div class="container">
			<div class="logo">
				<a href={`${base}/`}>
					<span class="logo-sub">สาขาวิชาเครื่องกลการผลิตและอุตสาหการ</span>
					<span class="logo-main">Production Mechanical & Industrial Engineering</span>
				</a>
			</div>

			<button
				type="button"
				class="mobile-toggle"
				aria-label="Toggle Menu"
				aria-expanded="false"
				aria-controls="primary-nav"
			>
				<span></span>
				<span></span>
				<span></span>
			</button>

			<ul class="nav-links" id="primary-nav">
				{navItems.map((item) => {
					const active = isActive(item.path);
					return (
						<li>
							<a
								href={item.href}
								class={active ? "active" : undefined}
								aria-current={active ? "page" : undefined}
							>
								{item.label}
							</a>
						</li>
					);
				})}
			</ul>
		</div>
	</nav>
</header>

<script>
	const toggle = document.querySelector(".mobile-toggle");
	const navLinks = document.querySelector(".nav-links");

	const closeMenu = () => {
		navLinks?.classList.remove("active");
		toggle?.classList.remove("active");
		toggle?.setAttribute("aria-expanded", "false");
	};

	toggle?.addEventListener("click", (e) => {
		e.stopPropagation();
		const isOpen = navLinks?.classList.toggle("active") ?? false;
		toggle.classList.toggle("active", isOpen);
		toggle.setAttribute("aria-expanded", String(isOpen));
	});

	navLinks?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", closeMenu);
	});

	document.addEventListener("click", (e) => {
		if (!navLinks?.classList.contains("active")) return;
		const target = e.target;
		if (target instanceof Node && !navLinks.contains(target) && !toggle?.contains(target)) {
			closeMenu();
		}
	});

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") closeMenu();
	});
</script>

<style>
	header {
		width: 100%;
		background: rgba(255, 255, 255, 0.95);
		backdrop-filter: blur(10px);
		box-shadow: var(--shadow-sm);
		position: sticky;
		top: 0;
		z-index: 1000;
		border-bottom: 2px solid var(--primary-light);
	}
	.top-bar {
		background: var(--primary);
		color: var(--white);
		padding: 6px 0;
		font-size: 0.8rem;
		font-weight: 300;
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0 20px;
	}
	.top-links {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}
	.top-divider {
		color: rgba(255, 255, 255, 0.5);
	}
	.top-links a {
		font-weight: bold;
		color: var(--accent);
	}
	.top-links a:hover {
		color: var(--white);
	}
	.main-nav {
		position: relative;
		padding: 12px 0;
	}
	.main-nav .container {
		flex-direction: column;
		align-items: stretch;
		gap: 10px;
	}
	.logo {
		align-self: flex-start;
	}
	.logo a {
		display: flex;
		flex-direction: column;
	}
	.logo-sub {
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--primary);
	}
	.logo-main {
		font-size: 0.75rem;
		color: var(--secondary);
		text-transform: uppercase;
		letter-spacing: 0.5px;
		margin-top: 2px;
	}
	.nav-links {
		display: flex;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px 12px;
	}
	.nav-links a {
		display: block;
		font-weight: 500;
		font-size: 0.9rem;
		color: var(--secondary);
		padding: 6px 12px;
		border-radius: 6px;
		transition: var(--transition);
		text-align: center;
	}
	.nav-links a:hover,
	.nav-links a.active {
		color: var(--primary);
		background: var(--primary-light);
	}
	.nav-links a.active {
		font-weight: 700;
	}

	/* Mobile Styles */
	.mobile-toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 5px;
	}
	.mobile-toggle span {
		display: block;
		width: 25px;
		height: 3px;
		background: var(--primary);
		transition: var(--transition);
		border-radius: 2px;
	}

	@media (max-width: 992px) {
		.nav-links a {
			font-size: 0.85rem;
			padding: 4px 10px;
		}
	}

	@media (max-width: 768px) {
		.university-name {
			font-size: 0.7rem;
		}
		.mobile-toggle {
			display: flex;
		}
		.main-nav .container {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: 0;
		}
		.nav-links {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			width: 100%;
			background: var(--white);
			flex-direction: column;
			padding: 20px;
			box-shadow: var(--shadow-lg);
			gap: 15px;
			border-top: 1px solid var(--primary-light);
			text-align: center;
		}
		.nav-links.active {
			display: flex;
		}
		.mobile-toggle.active span:nth-child(1) {
			transform: translateY(8px) rotate(45deg);
		}
		.mobile-toggle.active span:nth-child(2) {
			opacity: 0;
		}
		.mobile-toggle.active span:nth-child(3) {
			transform: translateY(-8px) rotate(-45deg);
		}
	}
</style>
