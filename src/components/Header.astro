---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header>
	<div class="top-bar">
		<div class="container">
			<span class="university-name">มหาวิทยาลัยราชภัฏสกลนคร • Sakon Nakhon Rajabhat University</span>
			<div class="top-links">
				<a href="https://snru.ac.th" target="_blank" rel="noopener noreferrer">SNRU Main Site</a>
			</div>
		</div>
	</div>
	<nav class="main-nav">
		<div class="container">
			<div class="logo">
				<a href={`${base}/`}>
					<span class="logo-sub">สาขาวิชาเครื่องกลการผลิตและอุตสาหการ</span>
					<span class="logo-main">Production Mechanical & Industrial Engineering</span>
				</a>
			</div>

			<button class="mobile-toggle" aria-label="Toggle Menu">
				<span></span>
				<span></span>
				<span></span>
			</button>

			<ul class="nav-links">
				<li><a href={`${base}/`}>หน้าแรก (Home)</a></li>
				<li><a href={`${base}/about`}>เกี่ยวกับเรา (About)</a></li>
				<li><a href={`${base}/programs`}>หลักสูตร (Programs)</a></li>
				<li><a href={`${base}/faculty`}>คณาจารย์ (Faculty)</a></li>
				<li><a href={`${base}/internship-prep`}>เตรียมฝึกงาน (Internship Prep)</a></li>
				<li><a href={`${base}/contact`}>ติดต่อเรา (Contact)</a></li>
			</ul>
		</div>
	</nav>
</header>

<script>
	const toggle = document.querySelector(".mobile-toggle");
	const navLinks = document.querySelector(".nav-links");

	toggle?.addEventListener("click", () => {
		navLinks?.classList.toggle("active");
		toggle?.classList.toggle("active");
	});
</script>

<style>
	header {
		width: 100%;
		background: rgba(255, 255, 255, 0.95);
		backdrop-filter: blur(10px);
		box-shadow: var(--shadow-sm);
		position: sticky;
		top: 0;
		z-index: 1000;
		border-bottom: 2px solid var(--primary-light);
	}
	.top-bar {
		background: var(--primary);
		color: var(--white);
		padding: 6px 0;
		font-size: 0.8rem;
		font-weight: 300;
	}
	.container {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 0 20px;
	}
	.top-links a {
		font-weight: bold;
		color: var(--accent);
	}
	.top-links a:hover {
		color: var(--white);
	}
	.main-nav {
		position: relative;
		padding: 12px 0;
	}
	.main-nav .container {
		flex-direction: column;
		align-items: stretch;
		gap: 10px;
	}
	.logo {
		align-self: flex-start;
	}
	.logo a {
		display: flex;
		flex-direction: column;
	}
	.logo-sub {
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--primary);
	}
	.logo-main {
		font-size: 0.75rem;
		color: var(--secondary);
		text-transform: uppercase;
		letter-spacing: 0.5px;
		margin-top: 2px;
	}
	.nav-links {
		display: flex;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px 12px;
	}
	.nav-links a {
		display: block;
		font-weight: 500;
		font-size: 0.9rem;
		color: var(--secondary);
		padding: 6px 12px;
		border-radius: 6px;
		transition: var(--transition);
		text-align: center;
	}
	.nav-links a:hover {
		color: var(--primary);
		background: var(--primary-light);
	}

	/* Mobile Styles */
	.mobile-toggle {
		display: none;
		flex-direction: column;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 5px;
	}
	.mobile-toggle span {
		display: block;
		width: 25px;
		height: 3px;
		background: var(--primary);
		transition: var(--transition);
		border-radius: 2px;
	}

	@media (max-width: 992px) {
		.nav-links a {
			font-size: 0.85rem;
			padding: 4px 10px;
		}
	}

	@media (max-width: 768px) {
		.university-name {
			font-size: 0.7rem;
		}
		.mobile-toggle {
			display: flex;
		}
		.main-nav .container {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: 0;
		}
		.nav-links {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			width: 100%;
			background: var(--white);
			flex-direction: column;
			padding: 20px;
			box-shadow: var(--shadow-lg);
			gap: 15px;
			border-top: 1px solid var(--primary-light);
			text-align: center;
		}
		.nav-links.active {
			display: flex;
		}
		.mobile-toggle.active span:nth-child(1) {
			transform: translateY(8px) rotate(45deg);
		}
		.mobile-toggle.active span:nth-child(2) {
			opacity: 0;
		}
		.mobile-toggle.active span:nth-child(3) {
			transform: translateY(-8px) rotate(-45deg);
		}
	}
</style>
